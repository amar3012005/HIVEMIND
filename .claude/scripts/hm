#!/usr/bin/env bash
# Read-only SINGULANCE production inspection helper.
# Mutations deliberately live in the reviewed release procedure, not this tool.
set -euo pipefail

SSH_TARGET="${HM_SSH_TARGET:-singulance}"
SERVICE="${HM_SERVICE:-hm-core}"

case "${1:-help}" in
  ps)
    ssh "$SSH_TARGET" "docker ps --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}'"
    ;;
  status)
    ssh "$SSH_TARGET" "docker inspect --format '{{.Name}} {{.Config.Image}} {{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{end}}' '$SERVICE'"
    ;;
  logs)
    since="${2:-5m}"
    ssh "$SSH_TARGET" "docker logs '$SERVICE' --since '$since' 2>&1 | tail -200"
    ;;
  release)
    ssh "$SSH_TARGET" "printf 'build-source: '; git -C /root/hivemind-next rev-parse HEAD; printf 'recorded-live: '; cat /root/.quickdeploy-last-sha 2>/dev/null || true; docker inspect --format '{{.Name}} {{.Config.Image}} {{.Image}}' '$SERVICE'"
    ;;
  health)
    curl -fsS https://api.singulancelabs.com/health
    printf '\n'
    curl -fsS https://core.singulancelabs.com/health
    printf '\n'
    ;;
  help|-h|--help)
    cat <<'EOF'
hm is read-only. Production is ssh singulance.

  hm ps                 list running containers/images
  hm status             inspect HM_SERVICE (default hm-core)
  hm logs [since]       recent service logs
  hm release            compare build-source/live record/image identity
  hm health             public API/Core health

For deploy, migration, restart, rollback, or cleanup, stop and follow
docs/PRODUCTION_RELEASE_PROTOCOL.md. Never put credentials in this script.
EOF
    ;;
  *)
    echo "unknown command: $1" >&2
    exit 2
    ;;
esac
