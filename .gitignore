# Never commit local benchmark secrets/runtime artifacts.
benchmarks/memorybench-hivemind/memorybench/.env.local
benchmarks/memorybench-hivemind/memorybench/data/
benchmarks/memorybench-hivemind/memorybench/node_modules/
benchmarks/memorybench-hivemind/memorybench/.git/

# Benchmark results may contain API keys
benchmarks/results/*.md
!core/data/mcp-connectors.json

