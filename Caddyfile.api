{
    admin off
}

https://api.hivemind.davinciai.eu:443 {
    reverse_proxy hivemind-control-plane:3000
    tls /etc/letsencrypt/live/api.hivemind.davinciai.eu/fullchain.pem /etc/letsencrypt/live/api.hivemind.davinciai.eu/privkey.pem {
        # Hybrid post-quantum key exchange (NIST FIPS 203 ML-KEM-768 + X25519).
        # Defeats harvest-now/decrypt-later. Caddy 2.11 supports x25519mlkem768.
        curves x25519mlkem768 x25519
    }
}
