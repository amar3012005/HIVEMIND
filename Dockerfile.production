# HIVE-MIND Core API - Production Dockerfile
# Simplified: Everything runs from /app (core directory)

FROM node:20-slim AS base

# imagemagick + poppler-utils are REQUIRED for PDF figure extraction, not optional.
# The KB ingest renders each page to an image before asking a vision model to
# describe it; without a renderer that step fails closed with
#   [docling-adapter] groq-vision failed: Render failed: spawnSync convert ENOENT
# and every figure, chart and diagram in every PDF is silently dropped. Verified
# absent on the live box (`command -v convert` and `pdftoppm` both empty), which
# made the picture_descriptions default shipped in b59ce73d6 completely inert.
# ghostscript backs ImageMagick's PDF delegate; poppler-utils supplies pdftoppm.
RUN apt-get update && \
    apt-get install -y --no-install-recommends dumb-init ca-certificates openssl tzdata wget \
      imagemagick ghostscript poppler-utils && \
    # Debian ships a policy that denies ImageMagick read/write on PDF (CVE-2016-3714
    # era hardening). Rendering a PDF page is exactly what we need, and the input is
    # a tenant upload we already type-gate and size-gate, so re-enable PDF only.
    sed -i 's/rights="none" pattern="PDF"/rights="read|write" pattern="PDF"/' \
      /etc/ImageMagick-6/policy.xml 2>/dev/null || true && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ==========================================
# BUILD STAGE
# ==========================================
FROM base AS builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 make g++ git zip && \
    rm -rf /var/lib/apt/lists/*

# Copy package files
COPY core/package.json core/package-lock.json ./
COPY core/prisma ./prisma
COPY core/tsconfig.json ./

# Install dependencies
RUN npm ci && npm cache clean --force

# Cache-bust arg: pass --build-arg CACHE_BUST=$(date +%s) to force src refresh
ARG CACHE_BUST=1

# Copy source code
COPY core/src ./src
COPY core/scripts ./scripts
COPY core/evals ./evals
COPY core/config ./config
COPY employees-service/src/HQ-runtime ./hq-runtime
COPY core/tests ./tests

# Generate Prisma client
RUN npx prisma generate

# Release gate: execute the security-sensitive chat contracts in the same
# dependency environment used to assemble the production image. Tests remain
# in the builder and are not copied into the lean runtime stage.
RUN CEREBRAS_API_KEY=test-only OPENROUTER_API_KEY=test-only node --test \
    tests/unit/multilingual-tool-contract.test.js \
    tests/integration/chat-orchestration.integration.test.js \
    tests/unit/chat-tool-authorization.test.js \
    tests/unit/chat-intent-decision.test.js

# ── Bake Chrome extension zip for /install/chrome-extension.zip route ──
# Copies extensions/chrome into the builder, then zips it into
# /app/data/extension/hivemind-chrome-extension.zip so the production
# image can serve it directly without runtime zipping.
COPY extensions ./extensions-src
RUN mkdir -p /app/data/extension && \
    cd extensions-src/chrome && \
    zip -r /app/data/extension/hivemind-chrome-extension.zip . \
      -x "*.md" -x ".DS_Store" -x "node_modules/*" \
      -x "*.bak" -x ".git/*" -x "*.test.js" -x "store-assets/*" && \
    EXT_VERSION=$(node -e "console.log(require('./manifest.json').version)") && \
    cp /app/data/extension/hivemind-chrome-extension.zip \
       /app/data/extension/hivemind-chrome-extension-v${EXT_VERSION}.zip && \
    echo "${EXT_VERSION}" > /app/data/extension/VERSION

# ==========================================
# PRODUCTION STAGE
# ==========================================
FROM base AS production

ARG NODE_ENV=production
ARG VERSION=1.0.0
ARG BUILD_DATE

ENV NODE_ENV=${NODE_ENV} \
    VERSION=${VERSION} \
    BUILD_DATE=${BUILD_DATE} \
    PORT=3000 \
    HOST=0.0.0.0 \
    LOG_LEVEL=info \
    LOG_FORMAT=json

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --ingroup nodejs nodejs

RUN mkdir -p /app/logs /app/data && \
    chown -R nodejs:nodejs /app

USER nodejs

# Copy from builder
COPY --from=builder --chown=nodejs:nodejs /app/src ./src
COPY --from=builder --chown=nodejs:nodejs /app/scripts ./scripts
COPY --from=builder --chown=nodejs:nodejs /app/evals ./evals
COPY --from=builder --chown=nodejs:nodejs /app/config ./config
COPY --from=builder --chown=nodejs:nodejs /app/hq-runtime ./hq-runtime
COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/package.json ./
COPY --from=builder --chown=nodejs:nodejs /app/prisma ./prisma
COPY --from=builder --chown=nodejs:nodejs /app/data/extension ./data/extension

RUN chmod -R 550 /app && chmod -R 770 /app/logs /app/data

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "src/server.js"]
