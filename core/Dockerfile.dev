# HIVE-MIND MCP Server Development Dockerfile
# Multi-stage build for optimized development image
# EU Sovereign: GDPR, NIS2, DORA compliant

FROM node:20-bookworm-slim AS base

# Install system dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      openssl \
      bash \
      git \
      python3 \
      make \
      g++ \
      wget \
      imagemagick \
      ghostscript \
      poppler-utils \
    && (sed -i 's/rights="none" pattern="PDF"/rights="read|write" pattern="PDF"/' \
      /etc/ImageMagick-6/policy.xml 2>/dev/null || true) \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# ==========================================
# Dependencies Stage
# ==========================================

FROM base AS deps

# Dependency installation is keyed only by the manifests. Prisma schema edits
# are frequent and must not invalidate the expensive npm layer on every local
# feature branch. The BuildKit cache also survives clean image rebuilds.
COPY core/package.json core/package-lock.json ./
# Lightpanda is an optional browser accelerator and its package already ignores
# postinstall download failures. The nightly GitHub binary download can hang
# deterministic container builds, so point only the install step at a harmless
# existing executable and keep every other dependency lifecycle script enabled.
RUN --mount=type=cache,target=/root/.npm \
    LIGHTPANDA_EXECUTABLE_PATH=/bin/false \
    PUPPETEER_SKIP_DOWNLOAD=true \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    npm ci --no-audit --no-fund --foreground-scripts

# Generate only after the schema arrives, then prune the already-cached tree.
COPY core/prisma ./prisma
RUN npx prisma generate && npm prune --omit=dev

# ==========================================
# Development Stage
# ==========================================

FROM base AS development

# Set NODE_ENV
ENV NODE_ENV=development

# Copy package files
COPY core/package.json ./

# Install all dependencies
RUN npm install

# Copy source code
COPY core ./
COPY src/ingestion ./ingestion

# Copy static HTML assets from repo root
COPY client.html ./
COPY ui-testing.html ./
COPY web ./web
COPY scripts/tampermonkey-hivemind-web.user.js ./scripts/tampermonkey-hivemind-web.user.js

# Expose API port
EXPOSE 3000

# Health check - check root endpoint
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

# Start development server
CMD ["npm", "run", "server"]

# ==========================================
# Production Stage
# ==========================================

FROM base AS production

# Set NODE_ENV
ENV NODE_ENV=production

# Create non-root user for security
RUN groupadd --gid 1001 nodejs \
    && useradd --uid 1001 --gid nodejs --create-home --shell /usr/sbin/nologin nodejs

# Copy production dependencies
COPY --from=deps --chown=nodejs:nodejs /app/node_modules ./node_modules

# Copy generated Prisma Client and schema artifacts
COPY --from=deps --chown=nodejs:nodejs /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=deps --chown=nodejs:nodejs /app/prisma ./prisma

# Copy source code
COPY --chown=nodejs:nodejs core/src ./src
COPY --chown=nodejs:nodejs core/config ./config
COPY --chown=nodejs:nodejs src/ingestion ./ingestion
COPY --chown=nodejs:nodejs core/package.json ./
COPY --chown=nodejs:nodejs client.html ./
COPY --chown=nodejs:nodejs ui-testing.html ./
COPY --chown=nodejs:nodejs web ./web
COPY --chown=nodejs:nodejs scripts/tampermonkey-hivemind-web.user.js ./scripts/tampermonkey-hivemind-web.user.js

# Switch to non-root user
USER nodejs

# Expose MCP port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1

# Start production server
CMD ["node", "src/server.js"]
