      "live"
    ],
    "args": [],
    "env": {},
    "updated_at": "2026-06-10T00:00:00.000Z",
    "native_provider": "slack",
    "static_tools": [
      {
        "name": "slack_search_messages",
        "description": "Full-text search the connected Slack workspace",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Slack search query (syntax: from:@name, in:#channel, after:YYYY-MM-DD)"
            },
            "count": {
              "type": "number",
              "description": "Max results (default 10, max 20)"
            }
          },
          "required": [
            "query"
          ]
        }
      },
      {
        "name": "slack_list_channels",
        "description": "List channels visible to the HIVEMIND bot",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": []
        }
      },
      {
        "name": "slack_channel_history",
        "description": "Recent messages in a channel",
        "inputSchema": {
          "type": "object",
          "properties": {
            "channel_id": {
              "type": "string",
              "description": "Slack channel id (C…) — resolve names via slack_list_channels"
            },
            "limit": {
              "type": "number",
              "description": "Messages to return (default 20, max 50)"
            }
          },
          "required": [
            "channel_id"
          ]
        }
      },
      {
        "name": "slack_read_thread",
        "description": "Read a full reply thread",
        "inputSchema": {
          "type": "object",
          "properties": {
            "channel_id": {
              "type": "string"
            },
            "thread_ts": {
              "type": "string",
              "description": "ts of the thread root message"
            }
          },
          "required": [
            "channel_id",
            "thread_ts"
          ]
        }
      },
      {
        "name": "slack_post_message",
        "description": "Post to a channel (draft-approval gated)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "channel_id": {
              "type": "string",
              "description": "Slack channel id (C…)"
            },
            "text": {
              "type": "string",
              "description": "Message text (Slack mrkdwn supported)"
            },
            "thread_ts": {
              "type": "string",
              "description": "Optional: reply in this thread"
            }
          },
          "required": [
            "channel_id",
            "text"
          ]
        }
      }
    ]
  },
