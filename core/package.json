{
  "name": "hivemind-core",
  "version": "1.0.0",
  "description": "HIVE-MIND Core Memory Engine - Graph-based AI memory with triple-operator logic, PostgreSQL + Apache AGE",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node src/index.js",
    "server": "node src/server.js",
    "worker:maintenance": "node src/workers/memory-maintenance-worker.js",
    "worker:sidecar": "node src/workers/app-sidecar-worker.js",
    "control-plane": "node src/control-plane-server.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node --loader ts-node/esm src/db/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset",
    "test": "node --test",
    "test:api": "node --test tests/api/",
    "test:unit": "node --test tests/unit/",
    "test:integration": "node --test tests/integration/",
    "test:oauth-smoke": "node --test tests/integration/oauth-flow.test.js",
    "test:coverage": "node --test --experimental-test-coverage",
    "lint": "eslint src/**/*.ts || echo 'No ESLint configured'",
    "check": "find src -name '*.js' -exec node --check {} \\;",
    "check:whatsapp-runtime": "node scripts/check-whatsapp-runtime.mjs",
    "eval:chat-v2": "node scripts/eval-native-chat-v2-golden.mjs",
    "eval:governed-agent": "node scripts/eval-governed-agent.mjs",
    "test:governed-agent-e2e": "node --test tests/integration/governed-agent-local-e2e.test.js tests/unit/governed-agent-contract.test.js tests/unit/governed-agent-runtime.test.js tests/unit/composio-session-service.test.js tests/unit/durable-chat-turn-store.test.js",
    "langsmith:governed-sync": "node scripts/sync-governed-agent-langsmith.mjs",
    "build": "tsc"
  },
  "dependencies": {
    "@humation/assets-humation-1": "^1.0.1",
    "@humation/core": "^1.0.1",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "langsmith": "^0.8.8",
    "@lightpanda/browser": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@noble/post-quantum": "^0.6.1",
    "@prisma/client": "^5.22.0",
    "@qdrant/js-client-rest": "1.12.0",
    "@tavily/core": "^0.7.2",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "bullmq": "^5.71.0",
    "cors": "^2.8.5",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "ioredis": "^5.10.0",
    "mammoth": "^1.12.0",
    "node-fetch": "^3.3.2",
    "oauth-1.0a": "^2.2.6",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.1",
    "playwright-core": "^1.54.2",
    "prisma": "^5.22.0",
    "stripe": "^17.5.0",
    "tesseract.js": "^6.0.1",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.21.0",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.21.0",
    "uuid": "14.0.1",
    "undici": "6.27.0",
    "whatsapp-web.js": "^1.34.1",
    "xlsx": "npm:@e965/xlsx@0.20.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.1"
  },
  "overrides": {
    "@qdrant/js-client-rest": {
      "undici": "6.27.0"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node --loader ts-node/esm src/db/seed.ts"
  }
}
