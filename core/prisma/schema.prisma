  orgId          String   @map("org_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String   @db.VarChar(32)
  mode           String   @default("external") @db.VarChar(20)
  capabilityJti  String   @unique @map("capability_jti") @db.VarChar(96)
