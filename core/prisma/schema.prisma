generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "hivemind")]
}

/// User accounts with ZITADEL IAM integration and HYOK encryption keys
/// GDPR-ready with soft delete (deleted_at) for right to erasure
model User {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  zitadelUserId        String                @unique @map("zitadel_user_id") @db.VarChar(255)
  email                String                @unique @db.VarChar(255)
  displayName          String?               @map("display_name") @db.VarChar(255)
  avatarUrl            String?               @map("avatar_url")
  timezone             String?               @default("UTC") @db.VarChar(50)
  locale               String?               @default("en") @db.VarChar(10)
  encryptionKeyId      String                @default(dbgenerated("gen_random_uuid()")) @map("encryption_key_id") @db.Uuid
  encryptionKeyVersion Int?                  @default(1) @map("encryption_key_version")
  createdAt            DateTime?             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastActiveAt         DateTime?             @map("last_active_at") @db.Timestamptz(6)
  deletedAt            DateTime?             @map("deleted_at") @db.Timestamptz(6)
  apiKeys              ApiKey[]              @relation("UserApiKeys")
  exportRequests       DataExportRequest[]   @relation("UserExportRequests")
  memories             Memory[]              @relation("UserMemories")
  platformIntegrations PlatformIntegration[] @relation("UserPlatformIntegrations")
  sessions             Session[]             @relation("UserSessions")
  syncLogs             SyncLog[]             @relation("UserSyncLogs")
  organizations        UserOrganization[]    @relation("UserOrganizations")
  pageIndexNodes       PageIndexNode[]       @relation("UserPageIndexNodes")
  teamMemberships      TeamMember[]          @relation("UserTeamMemberships")
  projectMemberships   ProjectMember[]       @relation("UserProjectMemberships")
  memoryProjects       MemoryProject[]       @relation("UserMemoryProjects")
  digitalEmployees     DigitalEmployee[]     @relation("UserCreatedEmployees")
  hyperRooms           HyperRoom[]           @relation("UserHyperRooms")
  seoSearchConsoleProperties SeoSearchConsoleProperty[] @relation("UserSeoSearchConsoleProperties")
  billingCheckouts           BillingCheckout[]
  webhookSubscriptions      WebhookSubscription[]
  identities                UserIdentity[]
  authIdentityEvents        AuthIdentityEvent[]

  @@map("users")
}

model UserIdentity {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  provider        String    @db.VarChar(32)
  providerSubject String    @map("provider_subject") @db.VarChar(255)
  normalizedEmail String?   @map("normalized_email") @db.VarChar(255)
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz(6)
  isPrimary       Boolean   @default(false) @map("is_primary")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@index([normalizedEmail])
  @@map("user_identities")
}

model EmailAuthChallenge {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emailCiphertext   String    @map("email_ciphertext") @db.Text
  emailLookupHash   String    @map("email_lookup_hash") @db.VarChar(64)
  otpHash           String    @map("otp_hash") @db.VarChar(128)
  linkTokenHash     String    @map("link_token_hash") @db.VarChar(128)
  intent            String    @default("auto") @db.VarChar(16)
  signupTicketCiphertext String? @map("signup_ticket_ciphertext") @db.Text
  requestFingerprintHash String? @map("request_fingerprint_hash") @db.VarChar(64)
  returnTo          String    @map("return_to") @db.Text
  environment       String    @db.VarChar(16)
  flagMode          String    @map("flag_mode") @db.VarChar(16)
  attempts          Int       @default(0)
  resendCount       Int       @default(0) @map("resend_count")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  resendAvailableAt DateTime  @map("resend_available_at") @db.Timestamptz(6)
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz(6)
  consumedAt        DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  outbox            AuthEmailOutbox[]
  events            AuthIdentityEvent[]

  @@index([emailLookupHash, createdAt(sort: Desc)])
  @@index([requestFingerprintHash, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("email_auth_challenges")
}

model AuthEmailOutbox {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  challengeId       String             @map("challenge_id") @db.Uuid
  environment       String             @db.VarChar(16)
  processingVersion Int                @default(1) @map("processing_version")
  payloadCiphertext String             @map("payload_ciphertext") @db.Text
  status            String             @default("pending") @db.VarChar(24)
  attempt           Int                @default(0)
  providerMessageId String?            @map("provider_message_id") @db.VarChar(255)
  providerStatus    String?            @map("provider_status") @db.VarChar(32)
  nextAttemptAt     DateTime?          @map("next_attempt_at") @db.Timestamptz(6)
  sentAt            DateTime?          @map("sent_at") @db.Timestamptz(6)
  terminalAt        DateTime?          @map("terminal_at") @db.Timestamptz(6)
  lastError         Json?              @map("last_error") @db.JsonB
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  challenge         EmailAuthChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([challengeId])
  @@map("auth_email_outbox")
}

model AuthIdentityEvent {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?             @map("user_id") @db.Uuid
  challengeId String?             @map("challenge_id") @db.Uuid
  eventType   String              @map("event_type") @db.VarChar(64)
  outcome     String              @db.VarChar(24)
  metadata    Json                @default("{}") @db.JsonB
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  challenge   EmailAuthChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([challengeId, createdAt(sort: Desc)])
  @@map("auth_identity_events")
}

/// Multi-tenant organizations with EU data residency settings
/// Supports GDPR, NIS2, DORA compliance flags
model Organization {
  id                           String             @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  zitadelOrgId                 String             @unique @map("zitadel_org_id") @db.VarChar(255)
  name                         String             @db.VarChar(255)
  slug                         String             @unique @db.VarChar(100)
  dataResidencyRegion          String?            @default("eu-central") @map("data_residency_region") @db.VarChar(50)
  complianceFlags              String[]           @default(["GDPR", "NIS2", "DORA"]) @map("compliance_flags")
  hsmProvider                  String?            @default("ovhcloud") @map("hsm_provider") @db.VarChar(50)
  hsmKeyArn                    String?            @map("hsm_key_arn") @db.VarChar(255)
  createdAt                    DateTime?          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime?          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  plan                         String?            @default("free") @map("plan") @db.VarChar(50)
  // Where this org's memory data plane lives: 'managed' (we host) | 'self_host' (their agent box).
  // Captured at onboarding so the dashboard can gate self-host orgs into the connect-your-agent flow
  // before showing the workspace — independent of whether the agent has registered yet.
  hostingMode                  String?            @default("managed") @map("hosting_mode") @db.VarChar(20)
  // Commercial profile is explicit. Hosting/storage remain the data-plane
  // settings; promotions may only select compatible combinations.
  accountType                  String             @default("personal") @map("account_type") @db.VarChar(32)
  commercialTerms             Json?              @map("commercial_terms") @db.JsonB
  companyProfile              Json?              @map("company_profile") @db.JsonB
  promotionCodeId             String?            @map("promotion_code_id") @db.Uuid
  // Memory plane is independent from billing plan: personal managed workspaces use embedded .amr,
  // enterprise stays on the relational/vector hybrid unless explicitly migrated.
  memoryStorageMode            String             @default("hybrid") @map("memory_storage_mode") @db.VarChar(32)
  // Stripe billing state — populated on first checkout, sync'd via webhook.
  stripeCustomerId             String?            @unique @map("stripe_customer_id") @db.VarChar(64)
  stripeSubscriptionId         String?            @map("stripe_subscription_id") @db.VarChar(64)
  subscriptionStatus           String?            @map("subscription_status") @db.VarChar(32)
  // active | trialing | past_due | canceled | unpaid | incomplete
  currentPeriodEnd             DateTime?          @map("current_period_end") @db.Timestamptz(6)
  trialEndsAt                  DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  billingEmail                 String?            @map("billing_email") @db.VarChar(255)
  defaultProjectPolicy         String             @default("private") @map("default_project_policy") @db.VarChar(50)
  memorySavePolicy             String             @default("private") @map("memory_save_policy") @db.VarChar(50)
  // Cognition scope toggles (workspace-admin choices). Default OFF — the
  // cognitive layer does nothing for an org until an admin opts in. Read via
  // raw SQL in cognition-pilot.js. See migration 20260606193000.
  cognitionOrgEnabled          Boolean            @default(false) @map("cognition_org_enabled")
  cognitionPersonalEnabled     Boolean            @default(false) @map("cognition_personal_enabled")
  // Per-org opt-in for the profile-dream cron (auto-maintain evolving user
  // profiles). Durable DB toggle surfaced in the Cognition tab; read via raw SQL
  // in governance-routes.js + server.js profile-dream-cron. See migration 20260623.
  profileAutomaintainEnabled   Boolean            @default(false) @map("profile_automaintain_enabled")
  campaignAutonomyMode         String             @default("MANUAL_REVIEW") @map("campaign_autonomy_mode") @db.VarChar(24)
  // Set to now() on the false→true toggle. The cognition loop clamps its
  // synthesis window to max(now-1h, this) so enabling NEVER backfills the
  // org's history — it starts from a 1h window at toggle-on and rolls forward.
  cognitionEnabledAt           DateTime?          @map("cognition_enabled_at") @db.Timestamptz(6)
  // Dream SCHEDULING (replaces the 1h rolling-window-only cadence). A scheduled
  // deep dream fires once/day with a wide lookback so it connects dots across the
  // whole period. mode: 'nightmode' (default — fire at midnight), 'interval' (fire
  // once inside [startHour,endHour)), or 'continuous' (legacy event-driven only).
  cognitionScheduleMode        String             @default("nightmode") @map("cognition_schedule_mode") @db.VarChar(20)
  cognitionWindowStartHour     Int?               @map("cognition_window_start_hour")
  cognitionWindowEndHour       Int?               @map("cognition_window_end_hour")
  cognitionScheduleTz          String             @default("UTC") @map("cognition_schedule_tz") @db.VarChar(64)
  // Cross-project dreaming: when true the loop may form bridges that span project
  // boundaries (otherwise dreams stay within a single project scope). Default OFF.
  cognitionCrossProjectEnabled Boolean            @default(false) @map("cognition_cross_project_enabled")
  // Per-tenant canonical clusterMin override (NULL = adaptive by corpus size).
  // Lets a sparse-entity enterprise lower the floor so its entities still
  // canonicalize, or a dense one raise it. Read by deriveClusterMin.
  cognitionClusterMin          Int?               @map("cognition_cluster_min")
  // Qdrant container ("collection") that holds ALL memory+evidence for this org.
  // Set on org creation (org_<id>); members + projects share it (filtered by
  // user_id/project_id/layer). Null until provisioned.
  vectorContainer              String?            @map("vector_container") @db.VarChar(255)
  apiKeys                      ApiKey[]           @relation("OrgApiKeys")
  memoryBoxConnection          MemoryBoxConnection?
  memories                     Memory[]           @relation("OrgMemories")
  invites                      OrgInvite[]
  projects                     Project[]
  teams                        Team[]             @relation("OrgTeams")
  digitalEmployees             DigitalEmployee[]  @relation("OrgDigitalEmployees")
  teamTasks                    TeamTask[]         @relation("OrgTeamTasks")
  users                        UserOrganization[] @relation("OrgUserOrganizations")
  pageIndexNodes               PageIndexNode[]    @relation("OrgPageIndexNodes")
  ssoConfig                    OrgSsoConfig?      @relation("OrgSsoConfig")
  hyperRooms                   HyperRoom[]        @relation("OrgHyperRooms")
  seoSearchConsoleProperties   SeoSearchConsoleProperty[] @relation("OrgSeoSearchConsoleProperties")
  seoSearchConsoleSnapshots    SeoSearchConsoleSnapshot[] @relation("OrgSeoSearchConsoleSnapshots")
  zernioExecutionProfile       ZernioOrgProfile? @relation("OrgZernioExecutionProfile")
  zernioWebhookEvents          ZernioWebhookEvent[]
  enterpriseInvitation         EnterpriseInvitation? @relation("RedeemedEnterpriseInvitation")
  retrievalConfig              RetrievalConfig?
  billingCheckouts             BillingCheckout[]
  stripeEvents                 StripeEvent[]
  webhookSubscriptions        WebhookSubscription[]
  webhookDeliveries           WebhookDelivery[]

  @@map("organizations")
}

/// Junction table for user-organization many-to-many relationship
/// roles[] is the authoritative multi-role array (P0-4 RBAC).
/// role (single) is kept for backward compatibility; new code reads roles[].
model UserOrganization {
  userId        String       @map("user_id") @db.Uuid
  orgId         String       @map("org_id") @db.Uuid
  role          String       @default("member") @db.VarChar(50)
  roles         String[]     @default([]) @map("roles")
  isActive      Boolean      @default(true) @map("is_active")
  cognitionPersonalOptIn Boolean @default(false) @map("cognition_personal_opt_in")
  deactivatedAt DateTime?    @map("deactivated_at") @db.Timestamptz(6)
  invitedAt     DateTime?    @default(now()) @map("invited_at") @db.Timestamptz(6)
  joinedAt      DateTime?    @map("joined_at") @db.Timestamptz(6)
  org           Organization @relation("OrgUserOrganizations", fields: [orgId], references: [id], onDelete: Cascade)
  user          User         @relation("UserOrganizations", fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, orgId])
  @@index([userId])
  @@index([orgId])
  @@map("user_organizations")
}

model OrgInvite {
  id         String       @id @default(uuid()) @db.Uuid
  orgId      String       @map("org_id") @db.Uuid
  email      String?
  role       String       @default("member")
  roles      String[]     @default([]) @map("roles")
  teamIds    String[]     @default([]) @map("team_ids")
  projectIds String[]     @default([]) @map("project_ids")
  token      String       @unique
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime?    @map("used_at") @db.Timestamptz(6)
  usedBy     String?      @map("used_by") @db.Uuid
  revokedAt  DateTime?    @map("revoked_at") @db.Timestamptz(6)
  revokedBy  String?      @map("revoked_by") @db.Uuid
  lastSentAt DateTime?    @map("last_sent_at") @db.Timestamptz(6)
  sendCount  Int          @default(1) @map("send_count")
  createdBy  String       @map("created_by") @db.Uuid
  idempotencyKey String?  @map("idempotency_key") @db.VarChar(200)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
  @@index([expiresAt])
  @@unique([orgId, createdBy, idempotencyKey])
  @@map("org_invites")
}

/// Tenant-scoped operational notifications for Workspace Admin. This is a
/// focused event inbox, not a general messaging system.
model WorkspaceNotification {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  type         String    @db.VarChar(80)
  title        String    @db.VarChar(180)
  body         String?
  resourceType String?   @map("resource_type") @db.VarChar(80)
  resourceId   String?   @map("resource_id") @db.VarChar(128)
  data         Json      @default("{}")
  dedupeKey    String?   @map("dedupe_key") @db.VarChar(200)
  readAt       DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orgId, userId, createdAt(sort: Desc)])
  @@index([orgId, userId, readAt])
  @@unique([orgId, userId, dedupeKey])
  @@map("workspace_notifications")
}

/// Durable, ordered projection log for the Cloudflare Platform Registry.
/// PostgreSQL keeps this table even after D1 becomes the control-plane authority:
/// it is the compatibility-projection repair ledger, never a memory-data outbox.
model PlatformRegistryOutbox {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  revision    BigInt   @unique @default(autoincrement()) @db.BigInt
  entityType  String   @map("entity_type") @db.VarChar(48)
  entityId    String   @map("entity_id") @db.Uuid
  operation   String   @db.VarChar(16)
  payload     Json
  status      String   @default("pending") @db.VarChar(24)
  attempts    Int      @default(0)
  leaseOwner  String?  @map("lease_owner") @db.VarChar(96)
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  lastError   String?  @map("last_error") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([entityType, entityId, revision])
  @@map("platform_registry_outbox")
}

/// Team — sub-unit inside an Organization (Eng, Marketing, Sales).
/// Members can be granted team-scope memory access via TeamMember.
model Team {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                String                @map("org_id") @db.Uuid
  name                 String                @db.VarChar(255)
  slug                 String                @db.VarChar(120)
  description          String?
  isDefault            Boolean               @default(false) @map("is_default")
  createdBy            String                @map("created_by") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt           DateTime?             @map("archived_at") @db.Timestamptz(6)
  org                  Organization          @relation("OrgTeams", fields: [orgId], references: [id], onDelete: Cascade)
  members              TeamMember[]
  projects             Project[]
  memories             Memory[]              @relation("TeamMemories")
  platformIntegrations PlatformIntegration[] @relation("TeamPlatformIntegrations")
  digitalEmployees     DigitalEmployee[]     @relation("TeamDigitalEmployees")
  teamTasks            TeamTask[]            @relation("TeamTeamTasks")

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("teams")
}

/// User ↔ Team membership with role.
model TeamMember {
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("member") @db.VarChar(50) // 'lead' | 'member'
  addedById String?  @map("added_by") @db.Uuid
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(6)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation("UserTeamMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@index([teamId])
  @@map("team_members")
}

/// Project — bounded context inside a Team (or directly under Org for legacy).
/// teamId is preferred; orgId retained for backward compatibility with existing
/// org-level projects predating the Team model.
model Project {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String          @map("org_id") @db.Uuid
  teamId            String?         @map("team_id") @db.Uuid
  name              String          @db.VarChar(255)
  slug              String          @db.VarChar(120)
  description       String?
  status            String          @default("active") @db.VarChar(20) // 'active' | 'archived'
  policy            String          @default("private") @db.VarChar(20) // 'private' | 'team_inherited' | 'org_visible'
  // Per-project self-evolve toggle (card switch). Default OFF. When true the
  // cognitive layer synthesizes/evolves this project's memories. Migration 20260606193000.
  selfEvolveEnabled Boolean         @default(false) @map("self_evolve_enabled")
  createdBy         String          @map("created_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt        DateTime?       @map("archived_at") @db.Timestamptz(6)
  org               Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team              Team?           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members           ProjectMember[]
  memories          MemoryProject[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([teamId])
  @@index([status])
  @@map("projects")
}

/// Optional explicit project membership. If empty, all team members can access.
model ProjectMember {
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("contributor") @db.VarChar(50) // 'owner' | 'contributor' | 'viewer'
  addedById String?  @map("added_by") @db.Uuid
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(6)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation("UserProjectMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@index([projectId])
  @@map("project_members")
}

/// Many-to-many: a memory can belong to N projects (e.g. cross-cutting research).
model MemoryProject {
  memoryId  String   @map("memory_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  addedById String?  @map("added_by") @db.Uuid
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(6)
  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?    @relation("UserMemoryProjects", fields: [addedById], references: [id], onDelete: SetNull)

  @@id([memoryId, projectId])
  @@index([memoryId])
  @@index([projectId])
  @@map("memory_projects")
}

/// Cross-platform authentication with AI platforms (ChatGPT, Claude, etc.)
/// Encrypted tokens using HYOK pattern for EU sovereignty
model PlatformIntegration {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  platformType           String    @map("platform_type") @db.VarChar(50)
  platformUserId         String?   @map("platform_user_id") @db.VarChar(255)
  platformDisplayName    String?   @map("platform_display_name") @db.VarChar(255)
  authType               String    @map("auth_type") @db.VarChar(50)
  accessTokenEncrypted   String?   @map("access_token_encrypted")
  refreshTokenEncrypted  String?   @map("refresh_token_encrypted")
  tokenExpiresAt         DateTime? @map("token_expires_at") @db.Timestamptz(6)
  apiKeyHash             String?   @map("api_key_hash") @db.VarChar(255)
  webhookSecretEncrypted String?   @map("webhook_secret_encrypted")
  oauthScopes            String[]  @map("oauth_scopes")
