/// P1 — progressive durable transcript. Each 10-min recording segment is persisted
/// here AS IT TRANSCRIBES (keyed by a client-generated session_id), so a long
/// meeting survives a tab crash and the transcript is recoverable. At save the
/// session's segments are linked to the new meeting row. Central durability for
/// managed/personal orgs only — self-host (remote) orgs keep segments in-browser
/// (transcript text must not transit central). meeting_id nullable until save.
model MeetingSegment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  meetingId  String?  @map("meeting_id") @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  idx        Int      @map("idx")
  text       String   @map("text")
  speakers   Json?    @map("speakers")
  startMs    Int?     @map("start_ms")
  endMs      Int?     @map("end_ms")
  status     String   @default("transcribed") @map("status") @db.VarChar(16)
  // P2 — per-segment Stage-1 extraction (entities/decisions/actions/topics),
  // computed async during the meeting so Stop only reduces, never extracts.
  extraction       Json?   @map("extraction")
  extractionStatus String  @default("pending") @map("extraction_status") @db.VarChar(16)
  extractionAttempts Int   @default(0) @map("extraction_attempts")
  extractionNextAttemptAt DateTime? @map("extraction_next_attempt_at") @db.Timestamptz(6)
  extractionLeaseExpiresAt DateTime? @map("extraction_lease_expires_at") @db.Timestamptz(6)
  extractionLastError String? @map("extraction_last_error")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([sessionId, idx], map: "meeting_segments_session_idx_key")
  @@index([meetingId], map: "meeting_segments_meeting_idx")
  @@index([orgId, userId], map: "meeting_segments_org_user_idx")
  @@index([extractionStatus, extractionNextAttemptAt, createdAt], map: "meeting_segments_extraction_retry_idx")
  @@map("meeting_segments")
}

