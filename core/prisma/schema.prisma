model DurableChatTurn {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String                  @map("org_id") @db.Uuid
  userId            String                  @map("user_id") @db.Uuid
  threadDigest      String?                 @map("thread_digest") @db.Char(64)
  idempotencyKey    String                  @map("idempotency_key") @db.VarChar(180)
  orchestrationMode String                  @default("off") @map("orchestration_mode") @db.VarChar(24)
  status            String                  @default("accepted") @db.VarChar(32)
  currentPhase      String                  @default("accepted") @map("current_phase") @db.VarChar(40)
  requestPayload    Json                    @map("request_payload") @db.JsonB
  scopeSnapshot     Json                    @default("{}") @map("scope_snapshot") @db.JsonB
  responsePayload   Json?                   @map("response_payload") @db.JsonB
  error             Json?                   @db.JsonB
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
