  eventType       String   @map("event_type") @db.VarChar(80)
  payload         Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([provider, providerEventId])
  @@index([orgId, sessionId])
  @@map("tara_provider_events")
}

/// TaraInsight — one row per call, generated at call end (LLM over the transcript).
/// data = { key_points[], action_items[], topics[], questions[], sentiment }.
model TaraInsight {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callId    String   @unique @map("call_id") @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  summary   String?
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orgId])
  @@map("tara_insights")
}

/// TaraCampaign — one outbound calling campaign. Tenant-scoped (org+user).
/// status: draft → active → paused → completed. complianceConfig holds the
/// per-campaign gate config (lawful basis, country allowlist, calling hours,
/// caps); recordingOptIn defaults false (recording off by default, P0 decision).
model TaraCampaign {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  unifiedCampaignId String? @map("unified_campaign_id") @db.Uuid
  name             String   @db.VarChar(200)
  status           String   @default("draft") @db.VarChar(20) // draft | active | paused | completed
  agentSkill       String?  @map("agent_skill") @db.VarChar(120)
  provider         String   @default("deepgram") @db.VarChar(32)
  configSnapshot   Json     @default("{}") @map("config_snapshot")
  goal             String?
  callingWindow    Json     @default("{}") @map("calling_window") // {tz, days[], startHour, endHour}
  caps             Json     @default("{}") // {concurrency, dailyMax}
  complianceConfig Json     @default("{}") @map("compliance_config")
  recordingOptIn   Boolean  @default(false) @map("recording_opt_in")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  contacts     TaraCampaignContact[]
  callAttempts TaraCallAttempt[]

  @@index([orgId])
  @@index([userId])
  @@index([orgId, status])
  @@index([unifiedCampaignId])
  @@map("tara_campaigns")
}

/// TaraCampaignContact — one dialable contact on a campaign list. Phone in
/// E.164. lawfulBasis + country drive the compliance gate. Distinct from the
/// gmail-derived `contacts` table (email-keyed CRM contacts).
model TaraCampaignContact {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId  String   @map("campaign_id") @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  phone       String   @db.VarChar(20) // E.164
  displayName String?  @map("display_name") @db.VarChar(255)
  company     String?  @db.VarChar(255)
  country     String?  @db.VarChar(2) // ISO 3166-1 alpha-2
  timezone    String?  @db.VarChar(60) // IANA tz
  lawfulBasis String?  @map("lawful_basis") @db.VarChar(40) // legitimate_interest | consent | ...
  status      String   @default("pending") @db.VarChar(20) // pending | gated | calling | done | skipped
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  campaign     TaraCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  callAttempts TaraCallAttempt[]

  @@unique([campaignId, phone])
  @@index([orgId])
  @@index([campaignId, status])
  @@map("tara_campaign_contacts")
}

/// TaraCallAttempt — state machine for one dial of one contact.
/// status: queued → gated → dialing → {no_answer|voicemail|connected}
///         → {declined|completed|callback} → done.
/// gateResult records the compliance-gate decision (allow|skip + reason).
/// sessionId links to tara_calls (the conversation record).
model TaraCallAttempt {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId  String    @map("campaign_id") @db.Uuid
  contactId   String    @map("contact_id") @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  attemptNo   Int       @default(1) @map("attempt_no")
  status      String    @default("queued") @db.VarChar(20)
  disposition String?   @db.VarChar(30)
  gateResult  Json?     @map("gate_result")
  sessionId   String?   @map("session_id") @db.VarChar(120)
  requestedSessionId String? @map("requested_session_id") @db.VarChar(120)
  callLegId   String?   @map("call_leg_id") @db.VarChar(120)
  provider    String    @default("deepgram") @db.VarChar(32)
  configSnapshot Json   @default("{}") @map("config_snapshot")
  actionKey   String?   @unique @map("action_key") @db.VarChar(120)
  runtimePlaybookRunId String? @map("runtime_playbook_run_id") @db.Uuid
  runtimeStageId String? @map("runtime_stage_id") @db.VarChar(120)
  outreachCampaignId String? @map("outreach_campaign_id") @db.Uuid
  outreachTargetId String? @map("outreach_target_id") @db.Uuid
  leadId String? @map("lead_id") @db.Uuid
  outboundActionId String? @map("outbound_action_id") @db.Uuid
  authorityRef String? @map("authority_ref") @db.VarChar(160)
  reconciliationState String @default("pending") @map("reconciliation_state") @db.VarChar(32)
  providerCandidates Json @default("[]") @map("provider_candidates")
  lastError String? @map("last_error")
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(6)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  endedAt     DateTime? @map("ended_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  campaign TaraCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  TaraCampaignContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([campaignId, status])
  @@index([contactId])
  @@index([runtimePlaybookRunId, runtimeStageId])
  @@index([outreachCampaignId, outreachTargetId])
  @@index([orgId, reconciliationState, updatedAt])
  @@map("tara_call_attempts")
}

/// ConsentLedger — append-only audit of consent/disclosure events for outbound
/// calling (GDPR / EU AI Act accountability). action: disclosed | granted |
/// withdrawn | declined. Never updated, only inserted.
model ConsentLedger {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  contactId  String?  @map("contact_id") @db.Uuid
  phone      String   @db.VarChar(20)
  action     String   @db.VarChar(20) // disclosed | granted | withdrawn | declined
  basis      String?  @db.VarChar(40)
  channel    String   @default("voice") @db.VarChar(20)
  source     String?  @db.VarChar(60)
  metadata   Json     @default("{}")
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@index([orgId])
  @@index([phone])
  @@index([contactId])
  @@map("consent_ledger")
}

/// DncList — do-not-call registry, per org. phone unique per org. The
/// compliance gate hard-blocks any phone present here.
model DncList {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId   String   @map("org_id") @db.Uuid
  phone   String   @db.VarChar(20)
  reason  String?  @db.VarChar(120)
  source  String?  @db.VarChar(60) // user | withdrawn | regulator | imported
  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  @@unique([orgId, phone])
  @@index([orgId])
  @@map("dnc_list")
}

/// AgentEval — one row per (agent, turn-line) scored by the CSI judge.
/// scores is { helpful, role_fit, evidence, opposition } in [0,1].
/// total is the weighted sum. usedForTuningAt is set when consumed by
/// a tuner run so each tune cycle waits for 20 fresh evals.
model AgentEval {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId         String    @map("agent_id") @db.Uuid
  turnId          String    @map("turn_id") @db.Uuid
  scores          Json
  total           Float
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usedForTuningAt DateTime? @map("used_for_tuning_at") @db.Timestamptz(6)
  turn            HyperTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([agentId, usedForTuningAt])
  @@index([turnId])
  @@map("agent_evals")
}

/// SlackEvent — deduped inbound event from a Slack workspace, routed
/// to a Digital Employee. Backed by Redis dedup; this table is the
/// durable audit + replay record.
model SlackEvent {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slackEventId       String           @unique @map("slack_event_id") @db.VarChar(64)
  workspaceId        String           @map("workspace_id") @db.VarChar(64)
  channelId          String?          @map("channel_id") @db.VarChar(64)
  ts                 String           @db.VarChar(64)
  eventType          String           @map("event_type") @db.VarChar(64)
  eventSubtype       String?          @map("event_subtype") @db.VarChar(64)
  routedToEmployeeId String?          @map("routed_to_employee_id") @db.Uuid
  payload            Json
  status             String           @default("queued") @db.VarChar(20)
  // queued | processing | done | failed | dlq
  attempts           Int              @default(0)
  errorMessage       String?          @map("error_message")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt        DateTime?        @map("completed_at") @db.Timestamptz(6)
  employee           DigitalEmployee? @relation(fields: [routedToEmployeeId], references: [id], onDelete: SetNull)

  @@index([workspaceId, channelId])
  @@index([status, createdAt])
  @@index([routedToEmployeeId])
  @@map("slack_events")
}

/// ActionIntent — every outbound action an employee wants to take.
/// Persisted before policy check, then approved/denied/executed.
/// Powers audit trail, replay, and human-in-the-loop approval flow.
model ActionIntent {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId   String          @map("employee_id") @db.Uuid
  actionType   String          @map("action_type") @db.VarChar(64)
  // slack_post | slack_react | slack_dm | slack_search | slack_history | memory_save
  payload      Json
  status       String          @default("pending") @db.VarChar(20)
  // pending | approved | executed | denied | failed
  denyReason   String?         @map("deny_reason")
  approvedById String?         @map("approved_by") @db.Uuid
  executedAt   DateTime?       @map("executed_at") @db.Timestamptz(6)
  result       Json?
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  employee     DigitalEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt(sort: Desc)])
  @@index([status])
  @@map("action_intents")
}

/// PageIndex hierarchical memory index nodes (optional optimization layer)
/// Stores memory IDs organized by topic/project tree (max 4 levels)
model PageIndexNode {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  orgId            String?         @map("org_id") @db.Uuid
  user             User            @relation("UserPageIndexNodes", fields: [userId], references: [id], onDelete: Cascade)
  org              Organization?   @relation("OrgPageIndexNodes", fields: [orgId], references: [id], onDelete: Cascade)
  parentId         String?         @map("parent_id") @db.Uuid
  parent           PageIndexNode?  @relation("PageIndexHierarchy", fields: [parentId], references: [id])
  children         PageIndexNode[] @relation("PageIndexHierarchy")
  label            String
  path             String
  nodeType         String          @default("topic") @map("node_type")
  depth            Int             @default(1)
  memoryIds        String[]        @default([]) @map("memory_ids")
  memoryCount      Int             @default(0) @map("memory_count")
  summary          String?         @map("summary") @db.Text // LLM-generated summary of memories in this node
  summaryUpdatedAt DateTime?       @map("summary_updated_at")
  autoGenerated    Boolean         @default(true) @map("auto_generated")
  customBranch     Boolean         @default(false) @map("custom_branch")
  lastPrunedAt     DateTime?       @map("last_pruned_at")
  crossRefs        String[]        @default([]) @map("cross_refs")
  cachedChildPaths String[]        @default([]) @map("cached_child_paths")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at")
  deletedAt        DateTime?       @map("deleted_at")

  @@unique([userId, path])
  @@index([userId])
  @@index([userId, depth])
  @@index([parentId])
  @@index([nodeType])
  @@map("PageIndexNode")
}

/// TeamTask — one collaborative run kicked off in the Python sidecar's
/// TeamRoom (AgentScope-backed multi-employee orchestration). One row
/// per team task; messages live in TeamTaskMessage.
model TeamTask {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String            @map("org_id") @db.Uuid
  teamId            String?           @map("team_id") @db.Uuid
  brief             String            @db.Text
  requestedBy       String?           @map("requested_by") @db.Uuid
  slackChannel      String?           @map("slack_channel") @db.VarChar(64)
  slackThreadTs     String?           @map("slack_thread_ts") @db.VarChar(32)
  rosterEmployeeIds String[]          @default([]) @map("roster_employee_ids") @db.Uuid
  status            String            @default("running") @db.VarChar(20)
  // running | completed | failed | cancelled
  roundsCompleted   Int               @default(0) @map("rounds_completed")
  maxRounds         Int               @default(2) @map("max_rounds")
  gateReason        String?           @map("gate_reason") @db.VarChar(40)
  finalAnswer       String?           @map("final_answer") @db.Text
  claimCount        Int               @default(0) @map("claim_count")
  reviewCount       Int               @default(0) @map("review_count")
  revisionCount     Int               @default(0) @map("revision_count")
  contradictions    Int               @default(0)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt         DateTime?         @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?         @map("completed_at") @db.Timestamptz(6)
  error             String?           @db.Text
  org               Organization      @relation("OrgTeamTasks", fields: [orgId], references: [id], onDelete: Cascade)
  team              Team?             @relation("TeamTeamTasks", fields: [teamId], references: [id], onDelete: SetNull)
  messages          TeamTaskMessage[]

  @@index([orgId])
  @@index([teamId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([slackChannel, slackThreadTs])
  @@map("team_tasks")
}

/// TeamTaskMessage — one published item in a TeamTask transcript
/// (phase output by an employee, or 'system' annotation from TeamRoom).
model TeamTaskMessage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  senderId   String   @map("sender_id") @db.Text
  // employee_id OR 'system'
  senderName String   @map("sender_name") @db.VarChar(120)
  senderRole String?  @map("sender_role") @db.VarChar(60)
  kind       String   @db.VarChar(20)
  // chat | claim | review | revision | synthesis | system
  roundNum   Int      @default(0) @map("round_num")
  content    String   @db.Text
  metadata   Json     @default("{}") @map("metadata") @db.JsonB
  ts         DateTime @default(now()) @db.Timestamptz(6)
  task       TeamTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, ts])
  @@index([taskId, kind])
  @@map("team_task_messages")
}

model InboundWebhookSubscription {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String                @map("user_id") @db.Uuid
  orgId                  String                @map("org_id") @db.Uuid
  providerKey            String                @map("provider_key") @db.VarChar(100)
  externalId             String                @map("external_id") @db.VarChar(255)
  webhookSecretEncrypted String?               @map("webhook_secret_encrypted") @db.VarChar(255)
  eventTypes             String[]              @map("event_types")
  webhookUrl             String                @map("webhook_url")
  registeredAt           DateTime              @default(now()) @map("registered_at") @db.Timestamptz(6)
