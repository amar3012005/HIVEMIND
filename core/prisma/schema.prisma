  userId         String    @map("user_id") @db.Uuid
  provider       String    @db.VarChar(24)
  status         String    @default("pending") @db.VarChar(24)
  targetPlanId   String    @map("target_plan_id") @db.VarChar(50)
  offer          Json      @default("{}")
  providerRef    String?   @unique @map("provider_ref") @db.VarChar(255)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([orgId, status, createdAt])
  @@index([userId, createdAt])
  @@map("billing_checkouts")
}

/// Per-API-key LLM usage rollup. Records EVERY LLM call against the org's HIVEMIND
/// API key — org_id + api_key_id + model + feature — so spend is attributable per key,
/// not just per org. OrgUsage stays the org-wide monthly total (unchanged); this is the
/// per-key / per-model / per-feature breakdown. For system / background / master-key calls that
/// run inside an org context but carry no request API key (cognition, dreaming, boot, worker jobs)
/// the writer stores the all-zero SENTINEL uuid so they fold into a single per-(org,month,model)
/// "system" row under the plain unique index (no NULLs → no expression-index fragility, and ON
/// CONFLICT inference stays on plain columns). NO FK by design: a usage/billing ledger must keep
/// spend history after a key is revoked, and the sentinel value has no api_keys row. Written
/// fire-and-forget at the LLM chokepoint (litellm-client + groq-fallback); a metering failure
/// never breaks a completion.
model ApiKeyUsage {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  apiKeyId         String    @default(dbgenerated("'00000000-0000-0000-0000-000000000000'::uuid")) @map("api_key_id") @db.Uuid
  month            String    @db.VarChar(7)
  model            String    @default("") @db.VarChar(128)
  feature          String    @default("") @db.VarChar(64)
  tokensProcessed  BigInt    @default(0) @map("tokens_processed")
  promptTokens     BigInt    @default(0) @map("prompt_tokens")
  completionTokens BigInt    @default(0) @map("completion_tokens")
  requests         BigInt    @default(0)
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([orgId, apiKeyId, month, model, feature], map: "uq_api_key_usage_org_key_month_model_feature")
  @@index([orgId, month], map: "idx_api_key_usage_org_month")
  @@index([apiKeyId, month], map: "idx_api_key_usage_key_month")
  @@map("api_key_usage")
}

/// Per-org SSO configuration: Zitadel project mapping, SAML IdP metadata, SCIM token.
/// Supports subdomain-based org routing for enterprise IdP-initiated login.
model OrgSsoConfig {
  orgId              String       @id @map("org_id") @db.Uuid
  ssoType            String       @default("zitadel_oidc") @map("sso_type") @db.VarChar(50)
  zitadelProjectId   String?      @map("zitadel_project_id") @db.VarChar(255)
  samlIdpMetadataUrl String?      @map("saml_idp_metadata_url")
  samlAcsUrl         String?      @map("saml_acs_url")
  scimTokenHash      String?      @map("scim_token_hash") @db.VarChar(255)
  scimTokenId        String?      @map("scim_token_id") @db.VarChar(64)
  subdomain          String?      @unique @db.VarChar(100)
  enabled            Boolean      @default(false)
  jitProvisioning    Boolean      @default(true) @map("jit_provisioning")
  defaultRole        String?      @default("member") @map("default_role")
  defaultTeamId      String?      @map("default_team_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  org                Organization @relation("OrgSsoConfig", fields: [orgId], references: [id], onDelete: Cascade)

  @@map("org_sso_configs")
}

enum MemoryType {
  fact
  event
  decision
  preference
  goal
  commitment
  policy
  procedure
  lesson
  summary
  synthesis
  conversation
  // Legacy compatibility only. New relationships are graph edges.
  relationship
}

enum RelationshipType {
  Updates
  Extends
  Derives
  Contradicts
  PartOf
  Mentions
}

enum VisibilityScope {
  private
  organization
  public
}

/// Access scope for a memory under the Teams + Projects model.
/// personal     — only the owning user can read
/// project      — accessible to members of any project this memory belongs to
/// team         — accessible to all members of primaryTeamId
/// organization — accessible to every member of org_id
enum MemoryScope {
  personal
  project
  team
  organization
}

/// Digital Employee — autonomous AI agent backed by SlackAgents +
/// AgentScope, running in the `hivemind-employees` Python sidecar
/// service. Each employee owns a persona, a Slack workspace presence,
/// a scoped HIVEMIND API key, and a policy ruleset.
model DigitalEmployee {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                 String         @map("org_id") @db.Uuid
  teamId                String?        @map("team_id") @db.Uuid
  name                  String         @db.VarChar(100)
  slug                  String         @db.VarChar(120)
  avatarUrl             String?        @map("avatar_url")
  persona               String // system prompt
  model                 String         @default("claude-haiku-4-5") @db.VarChar(100)
  llmProvider           String         @default("anthropic") @map("llm_provider") @db.VarChar(50)
  hivemindApiKeyId      String?        @map("hivemind_api_key_id") @db.Uuid
  scopedApiKeyEncrypted String?        @map("scoped_api_key_encrypted")
  scope                 String         @default("team") @db.VarChar(20)
  slackTeamId           String?        @map("slack_team_id") @db.VarChar(64)
  slackBotUserId        String?        @map("slack_bot_user_id") @db.VarChar(64)
  slackChannelsAllowed  String[]       @default([]) @map("slack_channels_allowed")
  // Per-message identity override (chat:write.customize). One shared Slack
  // app posts as N employees by overriding username + icon per call.
  slackDisplayName      String?        @map("slack_display_name")
  slackAvatarEmoji      String?        @map("slack_avatar_emoji")
  // Multi-agent collaboration metadata (Phase 3.3). roleArchetype gates
  // reviewer/synthesizer selection in the AgentScope TeamRoom phase
  // machine; peerReviewTargets is a list of OTHER archetypes this
  // employee likes to challenge — used to bias adversarial reviews.
  roleArchetype         String?        @map("role_archetype") @db.VarChar(40)
  peerReviewTargets     String[]       @default([]) @map("peer_review_targets")
  tools                 String[]       @default([])
  policyRules           Json           @default("{}") @map("policy_rules")
  // GLOBAL per-agent learned playbook (self-evolving Loop 1) — ordered operating
  // lessons distilled across ALL rooms. One row per org+slug. Surfaced lazily via the
  // recall_experience tool in rooms AND 1-on-1 chat. Stored here (NOT the vector KB) so
  // lessons never pollute recall. Distinct from hyper_rooms.evo_playbooks (per-room).
  evoPlaybook           Json?          @default("[]") @map("evo_playbook")
  // Per-agent connector grants → 1-on-1 chat registers the same toolkits the agent uses
  // in rooms. Distinct from hyper_rooms.enabledConnectors (per-room). Empty = none.
  enabledConnectors     String[]       @default([]) @map("enabled_connectors")
  status                String         @default("draft") @db.VarChar(20)
  // draft | deploying | running | paused | error
  replicas              Int            @default(1)
  maxReplicas           Int            @default(3) @map("max_replicas")
  metricsLast24h        Json?          @map("metrics_last_24h")
  lastActiveAt          DateTime?      @map("last_active_at") @db.Timestamptz(6)
  createdBy             String         @map("created_by") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt            DateTime?      @map("archived_at") @db.Timestamptz(6)
  org                   Organization   @relation("OrgDigitalEmployees", fields: [orgId], references: [id], onDelete: Cascade)
  team                  Team?          @relation("TeamDigitalEmployees", fields: [teamId], references: [id], onDelete: SetNull)
  creator               User           @relation("UserCreatedEmployees", fields: [createdBy], references: [id])
  events                SlackEvent[]
  intents               ActionIntent[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([status])
  @@index([slackTeamId])
  @@map("digital_employees")
}

/// HyperRoom — a per-user WhatsApp-style multi-agent workspace.
/// All assigned employees are always present in the room. Each user
/// message kicks off a Lead + Reactors turn that lives in HyperTurn.
/// Per-user (not per-org) for v1. summaryMemoryId is set on archive
/// when the transcript is distilled into a canonical Memory.
model HyperRoom {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  orgId              String       @map("org_id") @db.Uuid
  name               String       @db.VarChar(120)
  goal               String?
  participantIds     String[]     @default([]) @map("participant_ids") @db.Uuid
  template           String       @default("debate") @db.VarChar(40)
  /// Dedicated expertise pack (general plus versioned SEO, marketing, brand, capital, product, design, legal, and research packs).
  /// Orthogonal to template: a SEO room may still collaborate via debate/swarm/etc.
  roomTag            String       @default("general") @map("room_tag") @db.VarChar(40)
  /// Ownership boundary. Work rooms are human-facing, Director-led workspaces;
  /// runtime rooms are bounded specialist operators invoked by an HQ playbook.
  roomMode           String       @default("work") @map("room_mode") @db.VarChar(16)
  permanentLeadId    String?      @map("permanent_lead_id") @db.Uuid
  permanentSkepticId String?      @map("permanent_skeptic_id") @db.Uuid
  /// Per-character connector grants (legacy P2, superseded by enabledConnectors).
  agentConnectors    Json         @default("{}") @map("agent_connectors")
  /// Room-level connector toggles — one switch per connector, like the web tool.
  /// When a connector is enabled, EVERY agent in the room can use its tools
  /// during the run (lead or anyone, decided at runtime). Values are connector
  /// ids: github/notion/slack/hubspot/airtable/linear/gmail/google_docs.
  enabledConnectors  String[]     @default([]) @map("enabled_connectors")
  /// LLM quality mode: 'auto' (multi-model — cheap gather+debate, strong 120b synthesis)
  /// or 'best' (all gpt-oss-120b). Read by the sidecar to pick the model combo.
  qualityMode        String       @default("auto") @map("quality_mode") @db.VarChar(16)
  /// Additional Population-Sim toggle: 'on' runs an extra many-voice social simulation that
  /// produces a popup report folded into the synthesis; 'off' (default) leaves the main flow untouched.
  simMode            String       @default("off") @map("sim_mode") @db.VarChar(16)
  /// Evolution mode for room runtime behavior. Kept nullable for compatibility with existing rooms.
  evoMode            String?      @default("off") @map("evo_mode")
  /// Optional room-specific orchestration playbook persisted by the control plane.
  roomPlaybook       Json?        @map("room_playbook") @db.JsonB
  /// Population-Sim cast size (FE slider, 10-100). Default 24.
  simAgents          Int          @default(24) @map("sim_agents")
  /// Bounded episodic summaries of completed Room runs. This is continuity memory,
  /// distinct from the room method playbook and each employee's global playbook.
  roomJournal        Json         @default("[]") @map("room_journal")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt         DateTime?    @map("archived_at") @db.Timestamptz(6)
  summaryMemoryId    String?      @map("summary_memory_id") @db.Uuid
  projectId          String?      @map("project_id") @db.Uuid
  user               User         @relation("UserHyperRooms", fields: [userId], references: [id], onDelete: Cascade)
  org                Organization @relation("OrgHyperRooms", fields: [orgId], references: [id], onDelete: Cascade)
  turns              HyperTurn[]

  @@index([userId, orgId])
  @@index([archivedAt])
  @@index([projectId])
  @@index([orgId, roomMode])
  @@map("hyper_rooms")
}

/// HyperWorkOrder — a durable, bounded unit of agent work created by a Room
/// Director for a specific turn. This is intentionally separate from TeamTask:
/// TeamTask belongs to the older AgentScope team runtime, while WorkOrders are
/// the shared execution substrate beneath every HyperRoom domain pack.
model HyperWorkOrder {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId               String   @map("org_id") @db.Uuid
  roomId              String   @map("room_id") @db.Uuid
  turnId              String?  @map("turn_id") @db.Uuid
  hqCycleId           String?  @map("hq_cycle_id") @db.Uuid
  runtimeEpoch        String?  @map("runtime_epoch") @db.Uuid
  growthDelegationId  String?  @map("growth_delegation_id") @db.Uuid
  orderKey            String   @map("order_key") @db.VarChar(80)
  planStepId          String?  @map("plan_step_id") @db.VarChar(80)
  dependsOn           Json     @default("[]") @map("depends_on") @db.JsonB
  kind                String   @db.VarChar(40)
  status              String   @default("queued") @db.VarChar(40)
  title               String   @db.VarChar(180)
  objective           String   @db.Text
  ownerEmployeeId     String?  @map("owner_employee_id") @db.Uuid
  ownerSlug           String?  @map("owner_slug") @db.VarChar(120)
  ownerLane           String?  @map("owner_lane") @db.VarChar(40)
  selectedSkills      Json     @default("[]") @map("selected_skills") @db.JsonB
  requiredEvidence    Json     @default("[]") @map("required_evidence") @db.JsonB
  acceptanceCriteria  Json     @default("[]") @map("acceptance_criteria") @db.JsonB
  inputSnapshot       Json     @default("{}") @map("input_snapshot") @db.JsonB
  waitFor             Json     @default("{}") @map("wait_for") @db.JsonB
  handoff             Json     @default("{}") @db.JsonB
  artifactRefs        Json     @default("[]") @map("artifact_refs") @db.JsonB
  evidenceRefs        Json     @default("[]") @map("evidence_refs") @db.JsonB
  attempt             Int      @default(0)
  error               String?  @db.Text
  leaseOwner          String?  @map("lease_owner") @db.VarChar(160)
  leaseExpiresAt      DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  lastHeartbeatAt     DateTime? @map("last_heartbeat_at") @db.Timestamptz(6)
  startedAt           DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([turnId, orderKey])
  @@unique([hqCycleId, orderKey])
  @@index([orgId, roomId, status])
  @@index([turnId])
  @@index([turnId, planStepId])
  @@index([hqCycleId, status])
  @@index([orgId, runtimeEpoch, status])
  @@index([status, leaseExpiresAt], map: "hyper_work_orders_status_lease_idx")
  @@map("hyper_work_orders")
}

/// HyperWorkResult — append-only worker attempt output. The final Room
/// synthesis consumes compact results rather than raw tool transcripts.
model HyperWorkResult {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workOrderId String   @map("work_order_id") @db.Uuid
  runtimeEpoch String? @map("runtime_epoch") @db.Uuid
  attempt     Int      @default(1)
  status      String   @default("completed") @db.VarChar(20)
  summary     String   @db.Text
  output      Json     @default("{}") @db.JsonB
  evidence    Json     @default("[]") @db.JsonB
  artifacts   Json     @default("[]") @db.JsonB
  usage       Json     @default("{}") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([workOrderId, attempt])
  @@index([workOrderId])
  @@index([runtimeEpoch, createdAt(sort: Desc)])
  @@map("hyper_work_results")
}

/// AgentTrust — per-org meritocracy ledger. score in [0,1], starts 0.5.
/// Updated post-seal: lead-success +0.05, challenger-correct +0.05,
/// unresolved-escalate -0.05. Display-only in v1; routing weight wiring
/// in _pick_lead is phase-2 (observe 50-100 turns first).
model AgentTrust {
  orgId      String   @map("org_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  trustScore Float    @default(0.5) @map("trust_score")
  wins       Int      @default(0)
  losses     Int      @default(0)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([orgId, employeeId])
  @@index([orgId, trustScore])
  @@map("agent_trust")
}

/// HyperTurn — one user message + lead + reactors + (optional) round-2
/// debate, sealed atomically. lines holds the JSONL event log
/// (router, line, react, revise, validate, seal). idempotencyKey makes
/// double-clicks return the same turn instead of running a second time.
model HyperTurn {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId         String      @map("room_id") @db.Uuid
  seq            Int
  userMessage    String      @map("user_message")
  status         String      @default("live") @db.VarChar(20)
  // live | complete | failed | cost_capped
  lines          Json        @default("[]")
  costTokens     Int         @default(0) @map("cost_tokens")
  startedAt      DateTime    @default(now()) @map("started_at") @db.Timestamptz(6)
  sealedAt       DateTime?   @map("sealed_at") @db.Timestamptz(6)
  idempotencyKey String      @unique @map("idempotency_key") @db.VarChar(64)
  runtimePlaybookRunId String? @map("runtime_playbook_run_id") @db.Uuid
  runtimeStageId String? @map("runtime_stage_id") @db.VarChar(120)
  runtimeCheckpointSequence Int? @map("runtime_checkpoint_sequence")
  runtimeAttempt Int? @map("runtime_attempt")
  executionIdentity Json @default("{}") @map("execution_identity") @db.JsonB
  // Which specialist engine this Work Room turn runs as, chosen ONCE by a Director
  // classification call and never reselected — write-once at the DB level (see the
  // 20260811100000_hyper_turn_execution_profile migration). Distinct from
  // executionIdentity, which is the tamper-checked tenant envelope, not a routing
  // decision; overwriting one with the other would silently break either guarantee.
  executionProfile Json? @map("execution_profile") @db.JsonB
  executionPhase String @default("ACCEPTED") @map("execution_phase") @db.VarChar(32)
  candidateOutput Json @default("{}") @map("candidate_output") @db.JsonB
  verificationVerdict Json @default("{}") @map("verification_verdict") @db.JsonB
  lastProgressAt DateTime @default(now()) @map("last_progress_at") @db.Timestamptz(6)
  terminalReason String? @map("terminal_reason") @db.Text
  fastPlannerMode String @default("off") @map("fast_planner_mode") @db.VarChar(32)
  room           HyperRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  evals          AgentEval[]
  runtimePlaybookRun RuntimePlaybookRun? @relation(fields: [runtimePlaybookRunId], references: [id], onDelete: SetNull)
  eventOutbox     HyperTurnEventOutbox[]

  @@unique([roomId, seq])
  @@index([roomId])
  @@index([status])
  @@index([status, lastProgressAt])
  @@index([runtimePlaybookRunId, runtimeCheckpointSequence])
  @@index([runtimePlaybookRunId, runtimeStageId, runtimeAttempt])
  @@map("hyper_turns")
}

/// HyperClaim — a durable, queryable claim/hypothesis/synthesis artifact emitted
/// during a turn. Persisted from turn events (hypothesis | line:lead/synthesis |
/// chain_of_thought) so the reasoning graph survives beyond the lines[] transcript.
/// refId is the event's in-turn id (e.g. "h-{slug}"); relations reference it.
/// No @relation back-refs (matches AgentTrust) — kept additive; FK + cascade in SQL.
model HyperClaim {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turnId            String   @map("turn_id") @db.Uuid
  roomId            String   @map("room_id") @db.Uuid
  orgId             String   @map("org_id") @db.Uuid
  refId             String   @map("ref_id") @db.VarChar(120)
  agentSlug         String?  @map("agent_slug") @db.VarChar(120)
  agentName         String?  @map("agent_name") @db.VarChar(120)
  lane              String?  @db.VarChar(40)
  kind              String   @default("hypothesis") @db.VarChar(40)
  // hypothesis | lead | synthesis | refined
  text              String
  confidence        Float?
  round             Int      @default(0)
  evidenceMemoryIds String[] @default([]) @map("evidence_memory_ids") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([roomId])
  @@index([turnId])
  @@index([orgId])
  @@map("hyper_claims")
}

/// HyperTrial — a review/reaction/vote/validation verdict against a claim.
/// Verdict strings are HyperAgents-native (agree|extend|challenge|abstain for
/// reactions; resolved|escalate for validation; the consensus verdict for votes).
model HyperTrial {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turnId       String   @map("turn_id") @db.Uuid
  roomId       String   @map("room_id") @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  trialKind    String   @map("trial_kind") @db.VarChar(40)
  // peer_review | react | vote | validate | skeptic
  reviewerSlug String?  @map("reviewer_slug") @db.VarChar(120)
  reviewerName String?  @map("reviewer_name") @db.VarChar(120)
  targetRef    String?  @map("target_ref") @db.VarChar(120)
  verdict      String?  @db.VarChar(40)
  confidence   Float?
  content      String?
  round        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([roomId])
  @@index([turnId])
  @@index([orgId])
  @@map("hyper_trials")
}

/// HyperRelation — a provenance edge between artifacts (claim->memory derived_from,
/// trial->claim supports/contradicts, revised->original updates). fromRef/toRef are
/// in-turn refIds, not uuids.
model HyperRelation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turnId       String   @map("turn_id") @db.Uuid
  roomId       String   @map("room_id") @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  relationType String   @map("relation_type") @db.VarChar(40)
  fromRef      String   @map("from_ref") @db.VarChar(120)
  toRef        String   @map("to_ref") @db.VarChar(120)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([roomId])
  @@index([turnId])
  @@map("hyper_relations")
}

/// HyperApprovalRule — fine-grained, per-action-type standing approval rule.
/// Grok-Bot-style "always allow: create a Drive doc" while a different action
/// (e.g. gmail_send) still requires approval, per action label. Org-scoped
/// (an action type means the same thing everywhere in that org), not room-
/// scoped. No row for a label = existing per-turn write policy applies
/// unchanged (default behavior is completely untouched by this table).
model HyperApprovalRule {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  actionLabel  String   @map("action_label") @db.VarChar(160)
  decision     String   @db.VarChar(20)
  // always_allow | always_deny
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([orgId, actionLabel])
  @@index([orgId])
  @@map("hyper_approval_rules")
}

/// TaraCall — one row per TARA voice call (self-hosted AaaS). Org-scoped.
/// Created on WS connect, finalized on disconnect. Aggregates usage.
model TaraCall {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  sessionId        String    @unique(map: "tara_calls_session_id_key") @map("session_id") @db.VarChar(120)
  provider         String    @default("deepgram") @db.VarChar(32)
  providerModel    String?   @map("provider_model") @db.VarChar(120)
  configRevision   Int       @default(1) @map("config_revision")
  skillId          String?   @map("skill_id") @db.Uuid
  goal             String?
  mode             String    @default("external") @db.VarChar(20) // internal | external
  voiceId          String?   @map("voice_id") @db.VarChar(120)
  language         String    @default("en") @db.VarChar(10)
  status           String    @default("active") @db.VarChar(20) // active | completed | failed
  turnCount        Int       @default(0) @map("turn_count")
  durationMs       Int       @default(0) @map("duration_ms")
  promptTokens     Int       @default(0) @map("prompt_tokens")
  completionTokens Int       @default(0) @map("completion_tokens")
  inputAudioMs     Int       @default(0) @map("input_audio_ms")
  outputAudioMs    Int       @default(0) @map("output_audio_ms")
  billableMessages Int       @default(0) @map("billable_messages")
  toolUsage        Json      @default("{}") @map("tool_usage")
  estimatedCostMicros Int    @default(0) @map("estimated_cost_micros")
  failureCode      String?   @map("failure_code") @db.VarChar(120)
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt          DateTime? @map("ended_at") @db.Timestamptz(6)

  @@index([orgId])
  @@index([userId])
  @@index([orgId, startedAt])
  @@unique([orgId, sessionId])
  @@map("tara_calls")
}

/// TaraTurn — one row per conversation turn (real-time append). Holds per-turn
/// transcript + agent reply + latency breakdown + token usage.
model TaraTurn {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callId           String   @map("call_id") @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
