  position             Int       @default(0)
  requiredCapabilities Json      @default("[]") @map("required_capabilities") @db.JsonB
  context              Json      @default("{}") @db.JsonB
  result               Json      @default("{}") @db.JsonB
  blockedReason        String?   @map("blocked_reason")
  startedAt            DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([runtimeId, status, priority, position])
  @@map("hq_todos")
}

/// HqWorkflow is the durable operating graph owned by HQ. A workflow is not a
/// report or a Room turn: it is the authoritative lifecycle for one bounded
/// business outcome, whose individual steps may be delegated to specialist
/// Rooms and resumed from external events.
model HqWorkflow {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runtimeId         String    @map("runtime_id") @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  todoId            String?   @map("todo_id") @db.Uuid
  kind              String    @db.VarChar(80)
  title             String    @db.VarChar(240)
  objective         String
  status            String    @default("READY") @db.VarChar(32)
  graphVersion      Int       @default(1) @map("graph_version")
  authorityPolicy   Json      @default("{}") @map("authority_policy") @db.JsonB
  context           Json      @default("{}") @db.JsonB
  terminalReason    String?   @map("terminal_reason")
  startedAt         DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  steps             HqWorkflowStep[]
  artifacts         HqWorkflowArtifact[]

  @@index([runtimeId, status, createdAt])
  @@index([orgId, kind, status])
  @@unique([runtimeId, todoId])
  @@map("hq_workflows")
}

/// One idempotent, observable transition inside an HQ workflow. Each step is
/// owned by HQ, but may point at exactly one delegated Room work order.
model HqWorkflowStep {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId        String    @map("workflow_id") @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  stepKey           String    @map("step_key") @db.VarChar(100)
  title             String    @db.VarChar(240)
  kind              String    @db.VarChar(80)
  status            String    @default("PENDING") @db.VarChar(32)
  position          Int
  dependsOn         String[]  @default([]) @map("depends_on")
  roomTag           String?   @map("room_tag") @db.VarChar(80)
  workOrderId       String?   @map("work_order_id") @db.Uuid
  acceptance        Json      @default("[]") @db.JsonB
  input             Json      @default("{}") @db.JsonB
  result            Json      @default("{}") @db.JsonB
  retryCount        Int       @default(0) @map("retry_count")
  maxRetries        Int       @default(2) @map("max_retries")
  blockedReason     String?   @map("blocked_reason")
  dueAt             DateTime? @map("due_at") @db.Timestamptz(6)
  startedAt         DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  workflow          HqWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  artifacts         HqWorkflowArtifact[]

  @@unique([workflowId, stepKey])
  @@unique([workOrderId])
  @@index([orgId, status, dueAt])
  @@index([workflowId, position])
  @@map("hq_workflow_steps")
}

/// Artifact records are the only completion evidence HQ accepts from a Room.
/// Payloads may contain lead IDs, internal drafts, provider receipts, and
/// source references, but never credentials.
model HqWorkflowArtifact {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId        String    @map("workflow_id") @db.Uuid
  stepId            String?   @map("step_id") @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  artifactKey       String    @map("artifact_key") @db.VarChar(180)
  artifactType      String    @map("artifact_type") @db.VarChar(80)
  status            String    @default("READY") @db.VarChar(32)
  externalRef       String?   @map("external_ref") @db.VarChar(500)
  payload           Json      @default("{}") @db.JsonB
  sourceRefs        Json      @default("[]") @map("source_refs") @db.JsonB
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  workflow          HqWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  step              HqWorkflowStep? @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([workflowId, artifactKey])
  @@index([orgId, artifactType, status])
  @@index([stepId, createdAt])
  @@map("hq_workflow_artifacts")
}

model HqCapabilityRequest {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runtimeId   String    @map("runtime_id") @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  todoId      String?   @map("todo_id") @db.Uuid
  capability  String    @db.VarChar(100)
  provider    String    @db.VarChar(100)
  status      String    @default("REQUIRED") @db.VarChar(24)
  reason      String
  connectPath String?   @map("connect_path")
  correlationRef String? @map("correlation_ref") @db.VarChar(240)
  resumeCondition Json @default("{}") @map("resume_condition") @db.JsonB
  stateFingerprint String? @map("state_fingerprint") @db.VarChar(128)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([orgId, status, createdAt])
  @@map("hq_capability_requests")
}

/// Knowledge documents — parsed/normalized from source artifacts
/// Represents threads, files, web pages, conversations
model KnowledgeDocument {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // which ingestion pipeline produced this row — makes selective re-ingestion possible.
  // NOT processing_version, which is a retry counter on the job.
  pipelineVersion    Int                  @default(1) @map("pipeline_version")
  ingestMode         String               @default("both") @map("ingest_mode") @db.VarChar(16)
  userId             String               @map("user_id") @db.Uuid
  orgId              String               @map("org_id") @db.Uuid
  sourceArtifactId   String?              @map("source_artifact_id") @db.Uuid
  documentType       String               @map("document_type") @db.VarChar(50) // 'email_thread' | 'file' | 'conversation' | 'web_page' | 'code_module'
  title              String?              @db.VarChar(1000)
  sourcePlatform     String               @map("source_platform") @db.VarChar(50)
  sourceId           String?              @map("source_id") @db.VarChar(500)
  sourceUrl          String?              @map("source_url")
  threadId           String?              @map("thread_id") @db.VarChar(500)
  sessionId          String?              @map("session_id") @db.VarChar(500)
  parentDocumentId   String?              @map("parent_document_id") @db.Uuid
  documentDate       DateTime?            @map("document_date") @db.Timestamptz(6)
  author             String?              @db.VarChar(500)
  participants       String[]             @default([])
  tags               String[]             @default([])
  language           String?              @default("en") @db.VarChar(10)
  wordCount          Int?                 @map("word_count")
  parseStatus        String               @default("pending") @map("parse_status") @db.VarChar(20) // 'pending' | 'parsed' | 'failed'
  parseEngine        String?              @map("parse_engine") @db.VarChar(50) // 'docling' | 'pdf.js' | 'mammoth' | 'markdown'
  parseMetadata      Json                 @default("{}") @map("parse_metadata")
  structureExtracted Boolean              @default(false) @map("structure_extracted")
  // Canonical Memory Engine V5: canonical source identity. canonicalIngestKey is
  // a globally-unique hash of (org, source type, provider, external id, version,
  // content hash) — the idempotency key for a source version. contentHash is the
  // document-level content hash (segment-level hash already lives on
  // KnowledgeSegment). processingVersion gates re-processing when the pipeline
  // changes. These are additive + backward-compatible (all nullable).
  canonicalIngestKey String?              @map("canonical_ingest_key") @db.VarChar(128)
  sourceExternalId   String?              @map("source_external_id") @db.VarChar(500)
  sourceVersion      String?              @map("source_version") @db.VarChar(100)
  contentHash        String?              @map("content_hash") @db.VarChar(128)
  processingVersion  Int?                 @map("processing_version")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt         DateTime?            @map("archived_at") @db.Timestamptz(6)
  sourceArtifact     SourceArtifact?      @relation(fields: [sourceArtifactId], references: [id], onDelete: SetNull)
  parentDocument     KnowledgeDocument?   @relation("DocumentHierarchy", fields: [parentDocumentId], references: [id], onDelete: SetNull)
  childDocuments     KnowledgeDocument[]  @relation("DocumentHierarchy")
  segments           KnowledgeSegment[]
  entityMentions     EntityMention[]
  memoryLinks        MemoryEvidenceLink[]

  tables             DocumentTable[]
  @@unique([userId, orgId, sourcePlatform, sourceId])
  @@index([userId, orgId])
  @@index([documentType])
  @@index([sourcePlatform])
  @@index([threadId])
  @@index([sessionId])
  @@index([parentDocumentId])
  @@index([documentDate(sort: Desc)])
  @@index([parseStatus])
  @@index([orgId, ingestMode])
  @@index([tags], type: Gin)
  @@index([createdAt(sort: Desc)])
  // V5: idempotent source-version lookup. Unique per org so a re-ingest of the
  // same source version dedups to one document (nullable → legacy rows unaffected).
  @@unique([orgId, canonicalIngestKey], map: "knowledge_documents_org_canonical_key_uq")
  @@map("knowledge_documents")
}

/// Document segments — structural retrieval units
/// Chunks, sections, paragraphs, messages within documents
model KnowledgeSegment {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pipelineVersion    Int                  @default(1) @map("pipeline_version")
  documentId         String               @map("document_id") @db.Uuid
  userId             String               @map("user_id") @db.Uuid
  orgId              String               @map("org_id") @db.Uuid
  segmentType        String               @map("segment_type") @db.VarChar(50) // 'heading' | 'paragraph' | 'table' | 'code_block' | 'message' | 'chunk'
  content            String
  contentHash        String               @map("content_hash") @db.VarChar(64)
  segmentIndex       Int                  @map("segment_index") // position within document
  parentSegmentId    String?              @map("parent_segment_id") @db.Uuid
  previousSegmentId  String?              @map("previous_segment_id") @db.Uuid
  depth              Int                  @default(0) // heading depth, nesting level
  startOffset        Int?                 @map("start_offset")
  endOffset          Int?                 @map("end_offset")
  startPage          Int?                 @map("start_page")
  endPage            Int?                 @map("end_page")
  wordCount          Int?                 @map("word_count")
  embeddingModel     String?              @default("mistral-embed") @map("embedding_model") @db.VarChar(100)
  embeddingDimension Int?                 @default(1024) @map("embedding_dimension")
  vectorStored       Boolean              @default(false) @map("vector_stored")
  metadata           Json                 @default("{}") // heading level, table structure, code language, etc
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  document           KnowledgeDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parentSegment      KnowledgeSegment?    @relation("SegmentHierarchy", fields: [parentSegmentId], references: [id], onDelete: SetNull)
  childSegments      KnowledgeSegment[]   @relation("SegmentHierarchy")
  previousSegment    KnowledgeSegment?    @relation("SegmentSequence", fields: [previousSegmentId], references: [id], onDelete: SetNull)
  nextSegments       KnowledgeSegment[]   @relation("SegmentSequence")
  entityMentions     EntityMention[]
  memoryLinks        MemoryEvidenceLink[]

  @@unique([documentId, segmentIndex])
  @@index([documentId])
  @@index([userId, orgId])
  @@index([segmentType])
  @@index([parentSegmentId])
  @@index([previousSegmentId])
  @@index([contentHash])
  @@index([vectorStored])
  @@index([createdAt(sort: Desc)])
  @@map("knowledge_segments")
}

/// A spreadsheet is ROWS, not prose. The KB pipeline turns one into claims —
/// readable and recallable, but you can no longer count, filter or sum it, and a
/// question like "which channel indexes highest for Persona 3" becomes a guess.
///
/// Docling already returns {sheet, headers, rows}; document-first-ingestion
/// carried it and then dropped it on the floor. These two tables persist that
/// grid ALONGSIDE the summary claims, so tabular questions get an exact SQL
/// answer while semantic recall still works.
///
/// org_id is on BOTH tables, not just the parent: a row must be unreachable
/// without a tenant filter even if a query forgets to join.
model DocumentTable {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId   String              @map("document_id") @db.Uuid
  orgId        String              @map("org_id") @db.Uuid
  userId       String?             @map("user_id") @db.Uuid
  sheet        String?             @db.VarChar(255)
  tableIndex   Int                 @default(0) @map("table_index")
  headers      String[]            @default([])
  rowCount     Int                 @default(0) @map("row_count")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  rows         DocumentTableRow[]
  document     KnowledgeDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "document_tables_document_id_fkey")

  @@unique([documentId, tableIndex])
  @@index([orgId])
  @@index([documentId])
  @@map("document_tables")
}

model DocumentTableRow {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tableId   String        @map("table_id") @db.Uuid
  orgId     String        @map("org_id") @db.Uuid
  rowIndex  Int           @map("row_index")
  cells     Json
  table     DocumentTable @relation(fields: [tableId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "document_table_rows_table_id_fkey")

  @@unique([tableId, rowIndex])
  @@index([orgId])
  @@index([tableId])
  @@index([cells], type: Gin, map: "document_table_rows_cells_gin")
  @@map("document_table_rows")
}

/// Durable control-plane record for every Knowledge Base upload. Content stays
/// in the tenant's selected storage backend; this row contains orchestration,
/// authorization and billing metadata only.
model KnowledgeIngestJob {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  scopeType         String    @map("scope_type") @db.VarChar(24)
  scopeId           String?   @map("scope_id") @db.Uuid
  scopeKey          String    @map("scope_key") @db.VarChar(160)
  storageMode       String    @map("storage_mode") @db.VarChar(32)
  filename          String    @db.VarChar(500)
  contentType       String?   @map("content_type") @db.VarChar(160)
  mediaKind         String    @map("media_kind") @db.VarChar(24)
  ingestMode        String    @default("both") @map("ingest_mode") @db.VarChar(16)
  evidenceOnlyReason String?  @map("evidence_only_reason") @db.VarChar(32)
  checksum          String    @db.VarChar(64)
  status            String    @default("queued") @db.VarChar(32)
  stage             String    @default("accepted") @db.VarChar(48)
  progress          Int       @default(0)
  processingVersion Int       @default(1) @map("processing_version")
  orchestrationMode String    @default("bullmq") @map("orchestration_mode") @db.VarChar(32)
  workflowInstanceId String?  @map("workflow_instance_id") @db.VarChar(160)
  pipelineVersion   Int       @default(1) @map("pipeline_version")
  sourceObjectKey   String?   @map("source_object_key") @db.VarChar(700)
  sourceObjectEtag  String?   @map("source_object_etag") @db.VarChar(160)
  attempt           Int       @default(0)
  queueJobId        String?   @map("queue_job_id") @db.VarChar(160)
  documentId        String?   @map("document_id") @db.Uuid
  memoryIds         String[]  @default([]) @map("memory_ids") @db.Uuid
  pageCount         Int?      @map("page_count")
  segmentCount      Int?      @map("segment_count")
  candidateCount    Int?      @map("candidate_count")
  promotedCount     Int?      @map("promoted_count")
  usageSettledAt    DateTime? @map("usage_settled_at") @db.Timestamptz(6)
  errorCode         String?   @map("error_code") @db.VarChar(80)
  errorMessage      String?   @map("error_message")
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  steps             KnowledgeIngestStep[]

  @@index([orgId, userId, createdAt(sort: Desc)])
  @@index([orgId, status, updatedAt])
  @@index([orgId, scopeKey, checksum])
  @@index([orgId, ingestMode, status])
  @@index([queueJobId])
  @@index([workflowInstanceId])
  @@map("knowledge_ingest_jobs")
}

/// Idempotent, lease-backed receipts for an external durable orchestrator.
/// Large artifacts stay in object storage; this table records only hashes,
/// references, coverage and terminal verification evidence.
model KnowledgeIngestStep {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId             String    @map("job_id") @db.Uuid
  processingVersion Int       @map("processing_version")
  stageKey          String    @map("stage_key") @db.VarChar(64)
  shardKey          String    @default("root") @map("shard_key") @db.VarChar(160)
  status            String    @default("pending") @db.VarChar(24)
  attempt           Int       @default(0)
  inputDigest       String?   @map("input_digest") @db.VarChar(128)
  outputRefs        Json      @default("{}") @map("output_refs")
  coverage          Json      @default("{}")
  leaseUntil        DateTime? @map("lease_until") @db.Timestamptz(6)
  leaseToken        String?   @map("lease_token") @db.Uuid
  errorCode         String?   @map("error_code") @db.VarChar(80)
  errorMessage      String?   @map("error_message")
  startedAt         DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  job               KnowledgeIngestJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, processingVersion, stageKey, shardKey])
  @@index([jobId, processingVersion, status])
  @@index([status, leaseUntil])
  @@index([stageKey, status, createdAt])
  @@map("knowledge_ingest_steps")
}

model KnowledgeIngestLease {
  leaseKey          String   @id @map("lease_key") @db.VarChar(80)
  jobId             String   @map("job_id") @db.Uuid
  orgId             String   @map("org_id") @db.Uuid
  processingVersion Int      @map("processing_version")
  leaseToken        String   @map("lease_token") @db.Uuid
  leaseUntil        DateTime @map("lease_until") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([leaseUntil])
  @@index([orgId, leaseUntil])
  @@index([jobId, processingVersion])
  @@map("knowledge_ingest_leases")
}

/// Exactly-once settlement markers for billable Knowledge Base metrics.
model KnowledgeUsageSettlement {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  metric    String   @db.VarChar(32)
  amount    BigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([jobId, metric])
  @@index([orgId, userId, createdAt(sort: Desc)])
  @@map("knowledge_usage_settlements")
}

/// Durable, tenant-scoped Web Intelligence orchestration. Provider payloads are
/// retained only as a bounded result manifest; credentials never enter this row.
model WebIntelJob {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  type              String    @db.VarChar(24)
  status            String    @default("queued") @db.VarChar(24)
  request           Json      @default("{}")
  result            Json?     
  progress          Json      @default("[]")
  providerAttempts  Json      @default("[]") @map("provider_attempts")
  idempotencyKey    String?   @map("idempotency_key") @db.VarChar(128)
  runtimeUsed       String?   @map("runtime_used") @db.VarChar(64)
  fallbackApplied   Boolean   @default(false) @map("fallback_applied")
  durationMs        Int?      @map("duration_ms")
  pagesProcessed    Int       @default(0) @map("pages_processed")
  errorCode         String?   @map("error_code") @db.VarChar(80)
  errorMessage      String?   @map("error_message")
  retriedFromId     String?   @map("retried_from_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)

  // PostgreSQL enforces idempotency only when a caller supplied a key. The
  // partial unique index lives in the manual migration so anonymous browser
  // requests can coexist without a synthetic key.
  @@index([orgId, userId, idempotencyKey])
  @@index([orgId, userId, updatedAt(sort: Desc)])
  @@index([orgId, status, updatedAt])
  @@map("web_intel_jobs")
}

/// Exactly-once customer and provider accounting marker for a Web Intel job.
model WebIntelUsageSettlement {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  metric    String   @db.VarChar(40)
  amount    BigInt   @default(1)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([jobId, metric])
  @@index([orgId, userId, createdAt(sort: Desc)])
  @@map("web_intel_usage_settlements")
}

/// Named entities — people, orgs, projects, topics, locations, dates
model Entity {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String          @map("org_id") @db.Uuid
  entityType    String          @map("entity_type") @db.VarChar(50) // 'person' | 'organization' | 'project' | 'topic' | 'location' | 'date' | 'product'
  canonicalName String          @map("canonical_name") @db.VarChar(500)
  aliases       String[]        @default([])
  description   String?
  externalIds   Json            @default("{}") @map("external_ids") // { "email": "x@y.com", "slack_id": "U123", "github": "user" }
  confidence    Float           @default(0.8) @db.Real // entity resolution confidence
  mergedFromIds String[]        @default([]) @map("merged_from_ids") @db.Uuid // track entity merges
  isActive      Boolean         @default(true) @map("is_active")
  firstSeenAt   DateTime        @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt    DateTime        @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  mentionCount  Int             @default(0) @map("mention_count")
  metadata      Json            @default("{}")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  mentions      EntityMention[]
  TopicState    TopicState[]

  @@unique([orgId, entityType, canonicalName])
  @@index([orgId, entityType])
  @@index([canonicalName])
  @@index([aliases], type: Gin)
  @@index([lastSeenAt(sort: Desc)])
  @@index([mentionCount(sort: Desc)])
  @@map("entities")
}

/// Entity mentions in documents and segments
model EntityMention {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityId    String             @map("entity_id") @db.Uuid
  documentId  String?            @map("document_id") @db.Uuid
  segmentId   String?            @map("segment_id") @db.Uuid
  memoryId    String?            @map("memory_id") @db.Uuid
