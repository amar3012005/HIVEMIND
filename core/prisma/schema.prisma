  @@index([eventId])
  @@index([orgId, createdAt(sort: Desc)], map: "webhook_deliveries_org_idx")
  @@index([subscriptionId, createdAt(sort: Desc)], map: "webhook_deliveries_subscription_idx")
  @@map("webhook_deliveries")
}
