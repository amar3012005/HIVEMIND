/// Core memory storage with triple-operator versioning (Updates, Extends, Derives)
/// Supports cognitive scoring for spaced repetition and Ebbinghaus forgetting curve
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Memory {
  id                                                          String               @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  userId                                                      String               @map("user_id") @db.Uuid
  orgId                                                       String?              @map("org_id") @db.Uuid
  pipelineVersion                                             Int                  @default(1) @map("pipeline_version")
  content                                                     String
  memoryType                                                  MemoryType?          @default(fact) @map("memory_type")
  title                                                       String?              @db.VarChar(500)
  tags                                                        String[]
  sourcePlatform                                              String?              @map("source_platform") @db.VarChar(50)
  sourceSessionId                                             String?              @map("source_session_id") @db.VarChar(255)
  sourceMessageId                                             String?              @map("source_message_id") @db.VarChar(255)
  sourceUrl                                                   String?              @map("source_url")
  // P0 first-class HyperAgents provenance (nullable, additive; populated only for
  // hyperagents-agent saves — see prisma-graph-store.createMemory). Applied to the DB
  // via migration 20260723090000_add_hyperagents_provenance.
  producedByTurn                                              String?              @map("produced_by_turn") @db.Uuid
  producedByAgent                                             String?              @map("produced_by_agent") @db.VarChar(120)
  actionable                                                  Boolean?             @map("actionable")
  provenance                                                  Json?                @map("provenance")
  isLatest                                                    Boolean?             @default(true) @map("is_latest")
  supersedesId                                                String?              @map("supersedes_id") @db.Uuid
  supersededAt                                                DateTime?            @map("superseded_at") @db.Timestamptz(6)
  strength                                                    Float?               @default(1.0) @db.Real
  recallCount                                                 Int?                 @default(0) @map("recall_count")
  importanceScore                                             Float?               @default(0.5) @map("importance_score") @db.Real
  lastConfirmedAt                                             DateTime?            @default(now()) @map("last_confirmed_at") @db.Timestamptz(6)
  documentDate                                                DateTime?            @map("document_date") @db.Timestamptz(6)
  eventDates                                                  DateTime[]           @map("event_dates") @db.Timestamptz
  // Bi-temporal valid-time (transaction-time = createdAt). Lets us replay
  // "what did we know at time T" vs "what was true at time T".
  validFrom                                                   DateTime?            @map("valid_from") @db.Timestamptz(6)
  validTo                                                     DateTime?            @map("valid_to") @db.Timestamptz(6)
  visibility                                                  VisibilityScope?     @default(private)
  scope                                                       MemoryScope          @default(personal) @map("scope")
  primaryTeamId                                               String?              @map("primary_team_id") @db.Uuid
  sharedWithOrgs                                              String[]             @map("shared_with_orgs") @db.Uuid
  embeddingModel                                              String?              @default("mistral-embed") @map("embedding_model") @db.VarChar(100)
  embeddingDimension                                          Int?                 @default(1024) @map("embedding_dimension")
  embeddingVersion                                            Int?                 @default(1) @map("embedding_version")
  processingBasis                                             String?              @default("consent") @map("processing_basis") @db.VarChar(100)
  retentionUntil                                              DateTime?            @map("retention_until") @db.Timestamptz(6)
  exportBlocked                                               Boolean?             @default(false) @map("export_blocked")
  createdAt                                                   DateTime?            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                                   DateTime?            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                                                   DateTime?            @map("deleted_at") @db.Timestamptz(6)
  project                                                     String?              @map("project")
  // Phase P.3: formal Project FK. Backfilled from `project` string by name/slug
  // match. Recall filters by projectId (preferred) OR free-text `project` (legacy).
  projectId                                                   String?              @map("project_id") @db.Uuid
  version                                                     Int                  @default(1)
  codeMetadata                                                CodeMemoryMetadata?
  derivationSources                                           DerivationJob[]      @relation("DerivationSourceMemory")
  derivationTargets                                           DerivationJob[]      @relation("DerivationTargetMemory")
  organization                                                Organization?        @relation("OrgMemories", fields: [orgId], references: [id], onDelete: Cascade)
  supersedes                                                  Memory?              @relation("MemorySupersedes", fields: [supersedesId], references: [id], onDelete: Cascade)
  supersededBy                                                Memory[]             @relation("MemorySupersedes")
  user                                                        User                 @relation("UserMemories", fields: [userId], references: [id], onDelete: Cascade)
  primaryTeam                                                 Team?                @relation("TeamMemories", fields: [primaryTeamId], references: [id], onDelete: SetNull)
  memoryProjects                                              MemoryProject[]
  versions                                                    MemoryVersion[]
  memory_versions_memory_versions_related_memory_idTomemories MemoryVersion[]      @relation("memory_versions_related_memory_idTomemories")
  relationshipsFrom                                           Relationship[]       @relation("RelationshipFromMemory")
  relationshipsTo                                             Relationship[]       @relation("RelationshipToMemory")
  sourceMetadata                                              SourceMetadata?
  vectorEmbedding                                             VectorEmbedding?     @relation("MemoryVectorEmbedding")
  // Phase 1: Document-backed memory relations
  derivation                                                  MemoryDerivation?
  evidenceLinks                                               MemoryEvidenceLink[]
  entityMentions                                              EntityMention[]
  claimEvidenceLinks                                          ClaimEvidenceLink[]
  projectionState                                             MemoryProjectionState?
  projectionAttempts                                          MemoryProjectionAttempt[]

  // Phase 1 Cognition Loop: synthesis quality metadata
  // synthesisConfidence: LLM-scored confidence (0.0–1.0) for canonical-fact / synthesis-bridge outputs
  // synthesisEvidenceIds: UUIDs of source memories that produced this synthesis
  // synthesisClusterHash: stable hash of the tag-pair or cluster that produced this synthesis (cooldown key)
  // synthesisRevision: incremented each time this cluster re-synthesises
  synthesisConfidence  Float?   @map("synthesis_confidence")
  synthesisEvidenceIds String[] @map("synthesis_evidence_ids") @db.Uuid
  synthesisClusterHash String?  @map("synthesis_cluster_hash") @db.VarChar(128)
  synthesisRevision    Int      @default(1) @map("synthesis_revision")

  // Phase A tiered cache.
  //   tier 1 = thin index (title + entities + small embedding, body may be sparse)
  //   tier 2 = hot cache (full content + full embedding, lazy-hydrated)
  //   default 2 preserves existing behavior for memories created before this column existed.
  tier           Int       @default(2) @map("tier")
  lastAccessedAt DateTime? @map("last_accessed_at") @db.Timestamptz(6)
  promotedAt     DateTime? @map("promoted_at") @db.Timestamptz(6)

  // Phase 1 Cognitive layer:
  //   canonical  = stable fact promoted by governance (Turing-verified)
  //   bridge     = cross-cluster synthesis edge
  //   compression= summary of compacted cluster
  //   reflection = governance self-evaluation memory
  //   NULL       = ordinary evidence/memory tier (default)
  cognitiveLayerRole String? @map("cognitive_layer_role")

  // Canonical Memory Engine V5: structured claim identity. A claim is
  // subject+predicate(+qualifiers); claimKey is a stable hash used for dedup and
  // contradiction/history clustering (NOT unique — historical + contradictory
  // claims for the same key must coexist). extractionConfidence is the
  // per-claim extractor confidence (distinct from synthesisConfidence).
  claimKey             String?  @map("claim_key") @db.VarChar(128)
  claimSubject         String?  @map("claim_subject") @db.VarChar(500)
  claimPredicate       String?  @map("claim_predicate") @db.VarChar(500)
  claimQualifiers      Json?    @map("claim_qualifiers")
  extractionConfidence Float?   @map("extraction_confidence") @db.Real

  @@index([userId])
  @@index([orgId])
  @@index([project])
  @@index([projectId], map: "memories_project_id_idx")
  @@index([scope])
  @@index([primaryTeamId])
  @@index([memoryType])
  @@index([sourcePlatform])
  @@index([documentDate(sort: Desc)])
  @@index([strength(sort: Desc)])
  @@index([tags], type: Gin)
  // H8: GIN index so `synthesisEvidenceIds: { hasSome: [...] }` (the duplicate-
  // canonical evidence-overlap check, runs once per new synthesis) uses an index
  // instead of a per-row executor-level array scan over all latest syntheses.
  @@index([synthesisEvidenceIds], type: Gin, map: "memories_synthesis_evidence_ids_gin")
  @@index([version])
  // Partial index: only index memories that have a cluster hash (synthesis outputs only)
  @@index([synthesisClusterHash], map: "memories_synthesis_cluster_hash_idx")
  // C1 backstop (migration 20260615150000): a partial UNIQUE index
  // memories_one_latest_synthesis_per_cluster on (org_id, synthesis_cluster_hash)
  // WHERE is_latest AND deleted_at IS NULL AND synthesis_cluster_hash IS NOT NULL
  // enforces one live synthesis per cluster. Partial WHERE isn't expressible in
  // the Prisma DSL, so it is migration-only and intentionally absent here.
  @@index([tier], map: "memories_tier_idx")
  @@index([userId, tier, lastAccessedAt(sort: Desc)], map: "memories_user_tier_lastaccess_idx")
  @@index([cognitiveLayerRole], map: "memories_cognitive_layer_role_idx")
  // V5: claim clustering + dedup lookups. Non-unique (contradictory/historical
  // claims coexist); the isLatest+deletedAt tail keeps the live-claim scan tight.
  @@index([orgId, claimKey, isLatest, deletedAt], map: "memories_org_claim_latest_idx")
  // PHASE-A: a partial index `memories_principle_role_idx` on (org_id, updated_at DESC)
  // WHERE cognitive_layer_role = 'principle' exists in the DB (migration
  // 20260606000000_l2_principles_tier). The WHERE filter is not expressible in
  // the Prisma DSL, so it is migration-only and intentionally absent here.
  @@map("memories")
}

