/// Pending writes from agent — held for explicit user approval before
/// the write tool actually executes. Created by draft-approval middleware
/// whenever the agent tries to call a non-readOnly tool
/// (slack_send_message, slack_schedule_message, etc.). Resolved by FE
/// when user clicks Approve or Cancel.
model PendingWrite {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  orgId      String?   @map("org_id") @db.Uuid
  provider   String    @db.VarChar(50) // slack, notion, gmail, …
  toolGroup  String?   @map("tool_group") @db.VarChar(120)
  toolName   String    @map("tool_name") @db.VarChar(120)
  toolArgs   Json      @map("tool_args") @db.JsonB
  argsHash   String?   @map("args_hash") @db.VarChar(64)
  projectId  String?   @map("project_id") @db.Uuid
  connectionId String? @map("connection_id") @db.VarChar(160)
  traceId    String?   @map("trace_id") @db.VarChar(160)
  idempotencyKey String? @unique @map("idempotency_key") @db.VarChar(160)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  preview    String?   @db.Text // short human-readable summary for UI
  status     String    @default("draft") @db.VarChar(20) // draft | approved | cancelled | sent | failed
  result     Json?     @db.JsonB // tool response on send
  errorMsg   String?   @map("error_msg") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(6)
  sentAt     DateTime? @map("sent_at") @db.Timestamptz(6)

  @@index([userId, status, createdAt(sort: Desc)], map: "pending_writes_user_status_created_idx")
  @@index([orgId, createdAt(sort: Desc)], map: "pending_writes_org_created_idx")
  @@index([orgId, status, expiresAt])
  @@map("pending_writes")
}

/// Connector Runtime V1 — durable background sync job (plan §7). Postgres is the
/// job source of truth, replacing the file-backed MCPConnectorJobStore. Leased
/// via SKIP LOCKED by the sync worker, which delegates to the canonical
/// SyncEngine (→ ingestSource).
model ConnectorSyncJob {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId                    String    @map("org_id") @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  connectorId              String    @map("connector_id") @db.VarChar(120)
  connectionId             String?   @map("connection_id") @db.VarChar(160)
  mode                     String    @default("incremental") @db.VarChar(20)
  status                   String    @default("queued") @db.VarChar(20)
  cursor                   String?   @db.Text
  requestedScope           String?   @map("requested_scope") @db.VarChar(20)
  projectIds               String[]  @default([]) @map("project_ids") @db.Uuid
  processed                Int       @default(0)
  imported                 Int       @default(0)
  skipped                  Int       @default(0)
  failed                   Int       @default(0)
  attempt                  Int       @default(0)
  maxAttempts              Int       @default(5) @map("max_attempts")
  leaseOwner               String?   @map("lease_owner") @db.VarChar(160)
  leaseExpiresAt           DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  idempotencyKey           String?   @unique @map("idempotency_key") @db.VarChar(200)
  startedAt                DateTime? @map("started_at") @db.Timestamptz(6)
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt              DateTime? @map("completed_at") @db.Timestamptz(6)
  cancellationRequestedAt  DateTime? @map("cancellation_requested_at") @db.Timestamptz(6)
  lastError                String?   @map("last_error") @db.Text
  config                   Json?     @db.JsonB
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, leaseExpiresAt], map: "idx_connector_sync_jobs_lease")
  @@index([orgId, connectorId, createdAt], map: "idx_connector_sync_jobs_org")
  @@map("connector_sync_jobs")
}

/// Durable ledger of outbound VALUE ACTIONS that actually left the platform
/// (HyperAgents closed loop): an approved email send or an outbound TARA call.
/// One row per exit; `outcome` is filled later by the tracking side (Gmail
/// reply-matcher, TARA call-end insight). Feeds the dashboard outcomes counter
/// and (later) value-action billing.
model OutboundAction {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  roomId     String?   @map("room_id") @db.Uuid // hyper_rooms.id when sent from a room
  campaignId String?   @map("campaign_id") @db.Uuid
  campaignActionId String? @map("campaign_action_id") @db.Uuid
  approvalId String?   @map("approval_id") @db.VarChar(80)
  channel    String    @db.VarChar(20) // email | call
  recipient  String?   @db.VarChar(320) // email address or E.164 number
  subject    String?   @db.VarChar(500)
  messageId  String?   @map("message_id") @db.VarChar(160) // gmail message id / telnyx call leg id
  threadId   String?   @map("thread_id") @db.VarChar(160) // gmail thread id (reply matching)
  status     String    @default("sent") @db.VarChar(20) // sent | failed
  outcome    String?   @db.VarChar(40) // replied | booked | completed | bounced | no_answer
  outcomeAt  DateTime? @map("outcome_at") @db.Timestamptz(6)
  meta       Json?     @db.JsonB
  sentAt     DateTime  @default(now()) @map("sent_at") @db.Timestamptz(6)

  @@index([orgId, sentAt])
  @@index([orgId, threadId])
  @@index([orgId, outcome, sentAt])
  @@index([campaignId, sentAt])
  @@index([campaignActionId])
  @@map("outbound_actions")
}

