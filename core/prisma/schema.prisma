  trigger           Json      @default("{}") @db.JsonB
  context           Json      @default("{}") @db.JsonB
  stageAttempts     Json      @default("{}") @map("stage_attempts") @db.JsonB
  waitingFor        Json?     @map("waiting_for") @db.JsonB
  lastVerdict       Json      @default("{}") @map("last_verdict") @db.JsonB
