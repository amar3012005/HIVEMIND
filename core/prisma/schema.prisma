model DurableChatCheckpoint {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turnId         String          @map("turn_id") @db.Uuid
  phase          String          @db.VarChar(40)
  status         String          @default("pending") @db.VarChar(24)
  attempt        Int             @default(1)
  inputDigest    String?         @map("input_digest") @db.Char(64)
  receipt        Json            @default("{}") @db.JsonB
  error          Json?           @db.JsonB
  leaseToken     String?         @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime?       @map("lease_expires_at") @db.Timestamptz(6)
  startedAt      DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?       @map("completed_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  turn           DurableChatTurn @relation(fields: [turnId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([turnId, phase], map: "durable_chat_checkpoints_turn_phase_key")
  @@index([status, leaseExpiresAt], map: "durable_chat_checkpoints_recovery_idx")
  @@map("durable_chat_checkpoints")
}

model DurableChatEvent {
