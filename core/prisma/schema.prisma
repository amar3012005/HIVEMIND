  scopeKey          String    @default("global") @map("scope_key") @db.VarChar(80)
  playbookId        String    @map("playbook_id") @db.VarChar(160)
  playbookVersion   Int       @map("playbook_version")
  idempotencyKey    String    @map("idempotency_key") @db.VarChar(180)
  status            String    @default("ACTIVE") @db.VarChar(32)
  currentStageId    String    @map("current_stage_id") @db.VarChar(120)
  completedStageIds String[]  @default([]) @map("completed_stage_ids")
