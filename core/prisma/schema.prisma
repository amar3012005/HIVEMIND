// ── Salesforce / cross-system memory layer ─────────────────────────────────
// External refs map a memory to its system-of-record record (Salesforce ID,
// Slack message ts, Gmail message id, ...). Enables idempotent re-sync and
// cross-system entity correlation.
model ExternalRef {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memoryId       String   @map("memory_id") @db.Uuid
  system         String   @db.VarChar(50)
  objectType     String   @map("object_type") @db.VarChar(80)
  externalId     String   @map("external_id") @db.VarChar(255)
  externalUrl    String?  @map("external_url")
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  metadata       Json?    @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([organizationId, system, objectType, externalId, memoryId])
  @@index([organizationId, system, objectType])
  @@index([memoryId])
  @@index([externalId])
  @@map("external_refs")
}

// Canonical entities are the master IDs for real-world things. Multiple
// memories + cross-system refs collapse to one canonical entity.
model CanonicalEntity {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  canonicalName  String   @map("canonical_name")
  normalizedName String   @map("normalized_name")
  identityKey    String?  @map("identity_key") @db.VarChar(500)
  entityKind     String   @map("entity_kind") @db.VarChar(40)
  aliases        String[] @default([])
  primaryEmail   String?  @map("primary_email") @db.VarChar(255)
  emailDomains   String[] @default([]) @map("email_domains")
  verticalTags   String[] @default([]) @map("vertical_tags")
  externalRefs   Json     @default("{}") @map("external_refs")
  metadata       Json     @default("{}")
  mergedFrom     String[] @default([]) @map("merged_from") @db.Uuid
  confidence     Decimal  @default(1.00) @db.Decimal(3, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memoryLinks MemoryEntityLink[]
  subjectClaims CanonicalClaim[] @relation("CanonicalClaimSubject")
  objectClaims  CanonicalClaim[] @relation("CanonicalClaimObject")

  @@index([organizationId, entityKind])
  @@unique([organizationId, identityKey], map: "canonical_entities_org_identity_key")
  @@index([organizationId, entityKind, normalizedName], map: "canonical_entities_org_kind_normalized_idx")
  @@index([aliases], type: Gin)
  @@index([emailDomains], type: Gin)
  @@index([primaryEmail])
  @@map("canonical_entities")
}

model MemoryEntityLink {
  memoryId   String   @map("memory_id") @db.Uuid
  entityId   String   @map("entity_id") @db.Uuid
  role       String   @default("mentioned") @db.VarChar(40)
  confidence Decimal  @default(1.00) @db.Decimal(3, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  entity CanonicalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([memoryId, entityId, role])
  @@index([entityId])
  @@map("memory_entity_links")
}

/// Versioned registry for the bounded predicates accepted by the canonical graph.
model CanonicalPredicate {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String   @db.VarChar(80)
  version             Int      @default(1)
  aliases             String[] @default([])
  inverseName         String?  @map("inverse_name") @db.VarChar(80)
  subjectKinds        String[] @default([]) @map("subject_kinds")
  objectKinds         String[] @default([]) @map("object_kinds")
  riskClass           String   @default("low") @map("risk_class") @db.VarChar(20)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  claims              CanonicalClaim[]

  @@unique([name, version])
  @@index([aliases], type: Gin)
  @@map("canonical_predicates")
}

/// A factual edge between canonical entities (or an entity and a literal).
/// It is intentionally separate from `relationships`, which stores memory lineage only.
model CanonicalClaim {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  claimKey            String   @map("claim_key") @db.VarChar(128)
  kind                String   @default("entity_relation") @db.VarChar(40)
  subjectEntityId     String   @map("subject_entity_id") @db.Uuid
  predicateId         String   @map("predicate_id") @db.Uuid
  objectEntityId      String?  @map("object_entity_id") @db.Uuid
  objectLiteral       Json?    @map("object_literal")
  qualifiers          Json     @default("{}")
  confidence          Decimal  @default(1.00) @db.Decimal(4, 3)
  assertionStatus     String   @default("user_asserted") @map("assertion_status") @db.VarChar(32)
  lifecycleStatus     String   @default("active") @map("lifecycle_status") @db.VarChar(24)
  validFrom           DateTime? @map("valid_from") @db.Timestamptz(6)
  validTo             DateTime? @map("valid_to") @db.Timestamptz(6)
  knownAt             DateTime @default(now()) @map("known_at") @db.Timestamptz(6)
  processingVersion   Int      @default(1) @map("processing_version")
  sourceDigest        String   @map("source_digest") @db.VarChar(64)
  supersedesClaimId   String?  @map("supersedes_claim_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  subject             CanonicalEntity @relation("CanonicalClaimSubject", fields: [subjectEntityId], references: [id], onDelete: Restrict)
  objectEntity        CanonicalEntity? @relation("CanonicalClaimObject", fields: [objectEntityId], references: [id], onDelete: Restrict)
  predicate           CanonicalPredicate @relation(fields: [predicateId], references: [id], onDelete: Restrict)
  supersedes          CanonicalClaim? @relation("ClaimSupersession", fields: [supersedesClaimId], references: [id], onDelete: SetNull)
  supersededBy        CanonicalClaim[] @relation("ClaimSupersession")
  evidence            ClaimEvidenceLink[]

  @@unique([organizationId, claimKey])
  @@index([organizationId, subjectEntityId, predicateId])
  @@index([organizationId, objectEntityId])
  @@index([organizationId, validFrom, validTo])
  @@map("canonical_claims")
}

model ClaimEvidenceLink {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  claimId     String   @map("claim_id") @db.Uuid
  memoryId    String   @map("memory_id") @db.Uuid
