  startOffset Int?               @map("start_offset")
  endOffset   Int?               @map("end_offset")
  confidence  Float              @default(0.9) @db.Real
  context     String? // surrounding text
  metadata    Json               @default("{}")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  entity      Entity             @relation(fields: [entityId], references: [id], onDelete: Cascade)
  document    KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  segment     KnowledgeSegment?  @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  memory      Memory?            @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@index([documentId])
  @@index([segmentId])
  @@index([memoryId])
  @@index([createdAt(sort: Desc)])
  @@map("entity_mentions")
}

/// Links canonical memories to supporting evidence
