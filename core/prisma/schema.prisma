/// Persistent user profile facts — durable context layer
/// Separates standing user knowledge from episodic memory search
model UserProfile {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  orgId             String?   @map("org_id") @db.Uuid
  category          String    @default("static")
  key               String
  value             String
  confidence        Float     @default(1.0)
  sourceMemoryId    String?   @map("source_memory_id") @db.Uuid
  confirmedCount    Int       @default(1) @map("confirmed_count")
  lastConfirmedAt   DateTime  @default(now()) @map("last_confirmed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  // WS5 (evolving profile / dreaming): per-fact grounding lineage (a profile line
  // with zero evidence ids must NOT render — anti-hallucination) + when the
  // profile-dreamer last re-synthesized this user. Both additive/backward-compat.
  evidenceMemoryIds String[]  @default([]) @map("evidence_memory_ids") @db.Uuid
  lastDreamedAt     DateTime? @map("last_dreamed_at")
  // M7: source-project provenance. NULL = org-level identity fact (evidence spans
  // multiple projects or none); a project id = the fact was synthesized purely
  // from that project's memories. buildProfileContext(…, projectId) returns
  // project_id IS NULL OR project_id = :projectId so a project-scoped caller never
  // sees identity facts derived from OTHER projects' memories.
  projectId         String?   @map("project_id") @db.Uuid

  // M6: scoped per (user, org). The old (userId,key) unique allowed only ONE
  // fact per key across ALL of a user's orgs, so an org-A write overwrote the
  // org-B fact for the same key (cross-org identity bleed). org_id is populated
  // on every row; the lock key is also org-scoped (profile:<org>:<user>).
  @@unique([userId, orgId, key])
  @@index([userId])
  @@index([userId, category])
  @@index([userId, orgId, projectId], map: "user_profiles_user_org_project_idx")
  @@map("user_profiles")
}

