{
  "playbook_id": "marketing.strategy-to-growth-brief",
  "version": 3,
  "status": "ACTIVE",
  "name": "Marketing strategy to first-life program",
  "description": "A preparation-only Marketing Room lifecycle that turns retained company evidence into a validated strategy and an executable portfolio of versioned Runtime motions.",
  "metadata": {
    "owner_room_tag": "marketing",
    "supported_actions": ["formulate_go_to_market_strategy"],
    "effect_class": "internal",
    "terminal_states_by_action": {
      "formulate_go_to_market_strategy": ["strategy_program_ready", "strategy_needs_evidence", "cancelled"]
    }
  },
  "input_contract": {
    "fields": [
      {"path": "context.company", "type": "object", "required": true, "description": "Retained company identity and onboarding context."},
      {"path": "context.baseline", "type": "object", "required": true, "description": "Source-backed baseline and explicit limitations."},
      {"path": "context.admin_current_status", "type": "object", "required": false, "description": "Optional administrator-confirmed priorities, corrections and blockers."},
      {"path": "context.lifecycle_catalog", "type": "array", "required": true, "description": "Installed immutable lifecycle descriptors available for portfolio motions."},
      {"path": "request.instruction", "type": "string", "required": true, "description": "The current operating requirement in the selected locale."}
    ]
  },
  "initial_stage_id": "build_market_evidence",
  "terminal_states": ["strategy_program_ready", "strategy_needs_evidence", "cancelled"],
  "stages": [
    {
      "id": "build_market_evidence",
      "objective": "Build a source-backed marketing evidence ledger from onboarding, baseline, optional administrator status, company memory and current sources. Preserve contradictions and unknowns. Do not diagnose beyond the evidence and do not perform an external action.",
      "input_refs": ["context.company", "context.baseline", "context.admin_current_status", "context.request"],
      "expected_artifacts": ["marketing_evidence_ledger"],
      "execution": {"mode": "room", "config": {"contract": "room-phase.v2", "phase_kind": "strategy_evidence"}},
      "completion_checks": [
        {"predicate": "has_min_count", "select": "marketing_evidence_ledger", "value": 1},
        {"predicate": "is_source_backed", "select": "marketing_evidence_ledger"},
        {"predicate": "all_have_nonempty_field", "select": "marketing_evidence_ledger", "path": "data.market_evidence"},
        {"predicate": "all_have_nonempty_field", "select": "marketing_evidence_ledger", "path": "data.buyer_evidence"},
        {"predicate": "all_have_nonempty_field", "select": "marketing_evidence_ledger", "path": "data.unknowns"}
      ],
      "transitions": [{"default": true, "to_stage": "choose_strategy"}],
      "on_failure": "REPAIR",
      "max_attempts": 3
    },
    {
      "id": "choose_strategy",
      "objective": "Compare materially different audience, positioning, offer and route-to-market options. Choose one strategy, retain rejected options and risks, and ground the decision in the accepted evidence ledger. Perform no provider action.",
      "input_refs": ["artifacts.marketing_evidence_ledger", "context.company", "context.admin_current_status", "context.request"],
      "expected_artifacts": ["marketing_strategy_decision"],
      "execution": {"mode": "room", "config": {"contract": "room-phase.v2", "phase_kind": "strategy_decision"}},
      "completion_checks": [
        {"predicate": "has_min_count", "select": "marketing_strategy_decision", "value": 1},
        {"predicate": "is_source_backed", "select": "marketing_strategy_decision"},
        {"predicate": "all_have_nonempty_field", "select": "marketing_strategy_decision", "path": "data.chosen_strategy"},
        {"predicate": "all_have_nonempty_field", "select": "marketing_strategy_decision", "path": "data.rejected_options"},
        {"predicate": "all_have_nonempty_field", "select": "marketing_strategy_decision", "path": "data.validation_risks"}
      ],
      "transitions": [{"default": true, "to_stage": "design_first_life_portfolio"}],
      "on_failure": "REPAIR",
      "max_attempts": 3
    },
    {
      "id": "design_first_life_portfolio",
      "objective": "Design two to four evidence-backed first-life motions. Choose only exact playbook IDs, versions, supported actions and owner Rooms present in context.lifecycle_catalog. Do not infer lifecycle identity from task wording, do not pad weak evidence, and do not execute a motion.",
      "input_refs": ["artifacts.marketing_evidence_ledger", "artifacts.marketing_strategy_decision", "context.lifecycle_catalog", "context.request"],
      "expected_artifacts": ["first_life_motion_portfolio"],
      "execution": {"mode": "room", "config": {"contract": "room-phase.v2", "phase_kind": "strategy_portfolio"}},
      "completion_checks": [
        {"predicate": "has_min_count", "select": "first_life_motion_portfolio", "value": 1},
        {"predicate": "is_source_backed", "select": "first_life_motion_portfolio"},
        {"predicate": "all_have_min_items", "select": "first_life_motion_portfolio", "path": "data.motions", "value": 2},
        {"predicate": "all_have_nonempty_field", "select": "first_life_motion_portfolio", "path": "data.strategy_ref"}
      ],
      "transitions": [{"default": true, "to_stage": "validate_strategy_program"}],
      "on_failure": "REPAIR",
      "max_attempts": 3
    },
    {
      "id": "validate_strategy_program",
      "objective": "Validate evidence lineage, strategic coherence, lifecycle availability and dependency order. Preserve accepted upstream work. Return one final strategy artifact that references the evidence, decision and portfolio artifacts; perform no external action.",
      "input_refs": ["artifacts.marketing_evidence_ledger", "artifacts.marketing_strategy_decision", "artifacts.first_life_motion_portfolio", "context.lifecycle_catalog"],
      "expected_artifacts": ["marketing_strategy"],
      "execution": {"mode": "room", "config": {"contract": "room-phase.v2", "phase_kind": "strategy_validation"}},
      "completion_checks": [
        {"predicate": "has_min_count", "select": "marketing_strategy", "value": 1},
        {"predicate": "is_source_backed", "select": "marketing_strategy"},
        {"predicate": "all_have_nonempty_field", "select": "marketing_strategy", "path": "data.positioning"},
        {"predicate": "all_have_nonempty_field", "select": "marketing_strategy", "path": "data.audience"},
        {"predicate": "all_have_nonempty_field", "select": "marketing_strategy", "path": "data.portfolio_ref"}
      ],
      "transitions": [{"default": true, "to_stage": "materialize_strategy_program"}],
      "on_failure": "REPAIR",
      "max_attempts": 3
    },
    {
      "id": "materialize_strategy_program",
      "objective": "Validate and materialize the accepted portfolio as idempotent proposed Runtime tasks. Invalid motions remain rejected individually; valid motions remain durable and ordered.",
      "input_refs": ["artifacts.first_life_motion_portfolio", "artifacts.marketing_strategy", "context.lifecycle_catalog"],
      "expected_artifacts": ["runtime_task_materialization"],
      "execution": {"mode": "adapter", "adapter_id": "runtime-task-materializer", "operation": "execute", "config": {"input_key": "first_life_motion_portfolio", "strategy_key": "marketing_strategy"}},
      "completion_checks": [
        {"predicate": "has_min_count", "select": "runtime_task_materialization", "value": 1},
        {"predicate": "all_have_nonempty_field", "select": "runtime_task_materialization", "path": "data.accepted_todo_ids"},
        {"predicate": "all_have_nonempty_field", "select": "runtime_task_materialization", "path": "data.portfolio_ref"}
      ],
      "transitions": [{"default": true, "to_terminal": "strategy_program_ready"}],
      "on_failure": "ESCALATE"
    }
  ]
}
