{
  "playbook_id": "operations.browser-admin-checkin-to-status",
  "version": 1,
  "status": "ACTIVE",
  "name": "Browser administrator check-in to current status",
  "description": "An internal, user-initiated browser conversation that records current company status before first-life planning.",
  "metadata": {"owner_room_tag": "general", "supported_actions": ["collect_internal_company_status"]},
  "input_contract": {"fields": [{"path": "request.instruction", "type": "string", "required": true}]},
  "initial_stage_id": "offer_admin_checkin",
  "terminal_states": ["admin_checkin_skipped", "admin_status_recorded"],
  "stages": [
    {"id": "offer_admin_checkin", "objective": "Prepare an internal browser conversation from retained company evidence. Do not dial, message, or mutate leads.", "input_refs": ["context.company", "context.baseline", "context.request"], "expected_artifacts": ["admin_checkin_offer"], "execution": {"mode": "adapter", "adapter_id": "browser-admin-checkin", "operation": "execute", "config": {"action": "offer"}}, "completion_checks": [{"predicate": "has_min_count", "select": "admin_checkin_offer", "value": 1}], "waits_for_event": {"types": ["admin_checkin.started", "admin_checkin.skipped"], "correlation_path": "data.session_id", "timeout_after_seconds": 86400}, "presentation": {"waiting": {"title": "A brief internal check-in is available", "summary": "Runtime is waiting for the administrator to start the browser conversation or skip it for now."}}, "transitions": [{"default": true, "to_stage": "capture_admin_choice"}], "on_failure": "ESCALATE"},
    {"id": "capture_admin_choice", "objective": "Persist whether the administrator started or skipped the internal check-in.", "input_refs": ["event", "context.baseline"], "expected_artifacts": ["admin_checkin_choice"], "execution": {"mode": "adapter", "adapter_id": "browser-admin-checkin", "operation": "execute", "config": {"action": "capture_choice"}}, "completion_checks": [{"predicate": "has_min_count", "select": "admin_checkin_choice", "value": 1}], "transitions": [{"when": {"predicate": "field_equals", "select": "admin_checkin_choice", "path": "data.decision", "value": "skipped", "mode": "any"}, "to_terminal": "admin_checkin_skipped"}, {"default": true, "to_stage": "observe_browser_session"}], "on_failure": "ESCALATE"},
    {"id": "observe_browser_session", "objective": "Wait for the exact browser conversation to finish before analysis.", "input_refs": ["artifacts.admin_checkin_choice"], "expected_artifacts": ["browser_session_subscription"], "execution": {"mode": "adapter", "adapter_id": "browser-admin-checkin", "operation": "execute", "config": {"action": "observe"}}, "completion_checks": [{"predicate": "has_min_count", "select": "browser_session_subscription", "value": 1}], "waits_for_event": {"types": ["admin_checkin.completed"], "correlation_path": "data.session_id", "timeout_after_seconds": 14400}, "presentation": {"waiting": {"title": "Runtime is listening to the internal check-in", "summary": "The same first-life execution will continue after the browser conversation is completed."}}, "transitions": [{"default": true, "to_stage": "analyze_current_status"}], "on_failure": "ESCALATE"},
    {"id": "analyze_current_status", "objective": "Analyze the exact browser-session transcript with the retained company evidence. Persist current priorities, corrections, blockers, confidence, and proposed actions that require later confirmation.", "input_refs": ["context.company", "context.baseline", "artifacts.admin_checkin_choice", "event"], "expected_artifacts": ["user_current_status"], "execution": {"mode": "room", "config": {"contract": "room-phase.v1", "phase_kind": "review"}}, "completion_checks": [{"predicate": "has_min_count", "select": "user_current_status", "value": 1}, {"predicate": "is_source_backed", "select": "user_current_status"}], "transitions": [{"default": true, "to_stage": "record_current_status"}], "on_failure": "REPAIR", "max_attempts": 2},
    {"id": "record_current_status", "objective": "Record the accepted internal status in the Runtime journal without adding spoken instructions to the operating queue.", "input_refs": ["artifacts.user_current_status"], "expected_artifacts": ["journal_record"], "execution": {"mode": "adapter", "adapter_id": "runtime-journal", "operation": "execute", "config": {"input_key": "user_current_status", "output_key": "journal_record", "event_type": "first_life_admin_status"}}, "completion_checks": [{"predicate": "references_cover_all", "select": "journal_record", "path": "data.input_ref", "target_select": "user_current_status"}], "transitions": [{"default": true, "to_terminal": "admin_status_recorded"}], "on_failure": "ESCALATE"}
  ]
}
