{
  "playbook_id": "outreach.prospect-to-conversation",
  "version": 3,
  "status": "ACTIVE",
  "name": "Prospect to conversation",
  "description": "Let Outreach Intelligence prepare a complete grounded lead-and-message bundle, then create provider drafts, govern delivery, and observe replies through append-only artifacts.",
  "metadata": { "owner_room_tag": "outreach" },
  "input_contract": { "fields": [
    { "path": "target.quantity", "type": "integer", "description": "Optional bounded result count explicitly supplied by the objective.", "default_value": 10 },
    { "path": "target.location", "type": "string", "description": "Requested or retained geographic scope." },
    { "path": "target.segment", "type": "string", "description": "Requested or retained organization segment." },
    { "path": "constraints.delivery_requested", "type": "boolean", "description": "Whether delivery is requested after authority is granted.", "required": true, "default_value": false }
  ]},
  "initial_stage_id": "prepare_outreach_bundle",
  "terminal_states": ["prepared", "conversation_started"],
  "stages": [
    {
      "id": "prepare_outreach_bundle",
      "objective": "Find relevant prospective clients for the supplied company objective and geography, qualify them against retained company evidence, persist every accepted organization in the tenant lead book, and write one concise personalized email for every accepted verified recipient. Use the Outreach Room Director's normal skills, Google Maps and web evidence, and Leads tools. Preserve a distinct fit rationale and outreach angle for each lead. Do not send anything. Return all useful verified results available; do not invent a quantity when the request did not provide one.",
      "input_refs": ["trigger.payload", "context.company", "context.target", "context.constraints"],
      "expected_artifacts": ["lead_record", "message_record"],
      "execution": { "mode": "room", "config": { "contract": "room-phase.v1", "phase_kind": "prepare" } },
      "completion_checks": [
        { "predicate": "has_min_count", "select": "lead_record", "value": 1 },
        { "predicate": "is_source_backed", "select": "lead_record", "source_path": "source_refs", "value": 1 },
        { "predicate": "all_have_nonempty_field", "select": "lead_record", "path": "data.persistence_ref" },
        { "predicate": "all_have_nonempty_field", "select": "lead_record", "path": "data.fit_rationale" },
        { "predicate": "all_have_nonempty_field", "select": "lead_record", "path": "data.outreach_angle" },
        { "predicate": "unique_by", "select": "lead_record", "path": "data.persistence_ref" },
        { "predicate": "count_matches", "select": "message_record", "target_select": "lead_record" },
        { "predicate": "all_have_nonempty_field", "select": "message_record", "path": "data.recipient" },
        { "predicate": "all_have_nonempty_field", "select": "message_record", "path": "data.subject" },
        { "predicate": "all_have_nonempty_field", "select": "message_record", "path": "data.body" },
        { "predicate": "all_have_field", "select": "message_record", "path": "data.delivery_requested" },
        { "predicate": "all_reference_existing", "select": "message_record", "path": "data.lead_ref", "target_select": "lead_record", "target_path": "id" }
      ],
      "verifications": [
        { "adapter_id": "tenant-records", "operation": "verify", "select": "lead_record", "config": { "record_paths": ["data.persistence_ref"] } }
      ],
      "transitions": [{ "default": true, "to_stage": "prepare_drafts" }],
      "on_failure": "REPAIR",
      "max_attempts": 2
    },
    {
      "id": "prepare_drafts",
      "objective": "Create one provider draft from every accepted message and retain its provider identifier without changing the approved content.",
      "input_refs": ["artifacts.message_record"],
      "expected_artifacts": ["draft_record"],
      "execution": { "mode": "adapter", "adapter_id": "gmail", "operation": "execute", "config": { "action": "prepare_drafts" } },
      "completion_checks": [
        { "predicate": "count_matches", "select": "draft_record", "target_select": "message_record" },
        { "predicate": "all_have_nonempty_field", "select": "draft_record", "path": "data.draft_ref" },
        { "predicate": "all_have_nonempty_field", "select": "draft_record", "path": "data.recipient_ref" },
        { "predicate": "all_have_field", "select": "draft_record", "path": "data.delivery_requested" },
        { "predicate": "all_reference_existing", "select": "draft_record", "path": "data.message_ref", "target_select": "message_record", "target_path": "id" }
      ],
      "verifications": [{ "adapter_id": "gmail", "operation": "verify", "select": "draft_record" }],
      "transitions": [
        { "when": { "predicate": "field_equals", "select": "draft_record", "path": "data.delivery_requested", "value": false, "mode": "all" }, "to_terminal": "prepared" },
        { "default": true, "to_stage": "deliver_outreach" }
      ],
      "on_failure": "ESCALATE"
    },
    {
      "id": "deliver_outreach",
      "objective": "Send only authority-approved provider drafts and persist one immutable provider receipt per action.",
      "input_refs": ["context.constraints", "artifacts.draft_record"],
      "expected_artifacts": ["delivery_receipt"],
      "authority_gate": "external_write",
      "authority_policy_key": "external_writes",
      "execution": { "mode": "adapter", "adapter_id": "gmail", "operation": "execute", "config": { "action": "deliver" } },
      "completion_checks": [
        { "predicate": "count_matches", "select": "delivery_receipt", "target_select": "draft_record" },
        { "predicate": "has_provider_receipt", "select": "delivery_receipt", "receipt_path": "data.provider_receipt_id" },
        { "predicate": "status_in", "select": "delivery_receipt", "path": "data.status", "values": ["accepted", "delivered"] }
      ],
      "transitions": [{ "default": true, "to_stage": "observe_responses" }],
      "on_failure": "ESCALATE"
    },
    {
      "id": "observe_responses",
      "objective": "Create durable response observation subscriptions for every delivered thread.",
      "input_refs": ["artifacts.lead_record", "artifacts.delivery_receipt"],
      "expected_artifacts": ["observation_subscription"],
      "execution": { "mode": "adapter", "adapter_id": "gmail", "operation": "monitor" },
      "completion_checks": [
        { "predicate": "count_matches", "select": "observation_subscription", "target_select": "delivery_receipt" },
        { "predicate": "has_provider_receipt", "select": "observation_subscription", "receipt_path": "data.subscription_ref" }
      ],
      "waits_for_event": { "type": "response.received", "correlation_path": "data.correlation_ref" },
      "transitions": [{ "default": true, "to_stage": "handle_response" }],
      "on_failure": "REPAIR",
      "max_attempts": 2
    },
    {
      "id": "handle_response",
      "objective": "Read and classify the correlated response, update the retained lead timeline, and return the next governed action without inventing intent.",
      "input_refs": ["context.company", "artifacts.lead_record", "artifacts.delivery_receipt", "artifacts.observation_subscription", "event"],
      "expected_artifacts": ["response_record"],
      "completion_checks": [
        { "predicate": "has_min_count", "select": "response_record", "value": 1 },
        { "predicate": "all_have_field", "select": "response_record", "path": "data.classification" },
        { "predicate": "all_have_field", "select": "response_record", "path": "data.timeline_ref" },
        { "predicate": "all_have_field", "select": "response_record", "path": "data.provider_event_ref" },
        { "predicate": "is_source_backed", "select": "response_record", "source_path": "source_refs", "value": 1 }
      ],
      "verifications": [{ "adapter_id": "tenant-records", "operation": "verify", "select": "response_record", "config": { "record_paths": ["data.timeline_ref"], "source_artifact_paths": ["data.provider_event_ref"] } }],
      "transitions": [{ "default": true, "to_terminal": "conversation_started" }],
      "on_failure": "REPAIR",
      "max_attempts": 2
    }
  ]
}
