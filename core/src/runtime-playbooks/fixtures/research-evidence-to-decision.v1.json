{
  "playbook_id": "research.evidence-to-decision",
  "version": 1,
  "status": "ACTIVE",
  "name": "Evidence to decision",
  "description": "A preparation-only Research Room lifecycle for a bounded source-backed decision.",
  "metadata": {
    "owner_room_tag": "research",
    "supported_actions": ["produce_source_backed_decision"],
    "effect_class": "internal",
    "terminal_states_by_action": {
      "produce_source_backed_decision": ["decision_ready", "decision_needs_evidence", "cancelled"]
    }
  },
  "input_contract": {
    "fields": [
      {"path": "context.company", "type": "object", "required": true, "description": "Retained company identity and context."},
      {"path": "request.instruction", "type": "string", "required": true, "description": "The bounded decision objective."}
    ]
  },
  "initial_stage_id": "research_decision",
  "terminal_states": ["decision_ready", "decision_needs_evidence", "cancelled"],
  "stages": [
    {
      "id": "research_decision",
      "objective": "Use the Research Room Director, relevant skills and current sources to resolve the bounded decision. Separate observed evidence, contradictions, uncertainty and professional judgement. Return one decision-ready artifact and perform no external write.",
      "input_refs": ["context.company", "context.baseline", "context.request", "context.evidence_refs"],
      "expected_artifacts": ["research_decision"],
      "execution": {"mode": "room", "config": {"contract": "room-phase.v2", "phase_kind": "research"}},
      "completion_checks": [
        {"predicate": "has_min_count", "select": "research_decision", "value": 1},
        {"predicate": "is_source_backed", "select": "research_decision"},
        {"predicate": "all_have_nonempty_field", "select": "research_decision", "path": "data.decision"},
        {"predicate": "all_have_nonempty_field", "select": "research_decision", "path": "data.evidence"},
        {"predicate": "all_have_nonempty_field", "select": "research_decision", "path": "data.unknowns"}
      ],
      "transitions": [{"default": true, "to_terminal": "decision_ready"}],
      "on_failure": "REPAIR",
      "max_attempts": 3
    }
  ]
}
