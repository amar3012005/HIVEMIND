{
  "name": "singulance",
  "version": "2.1.2",
  "description": "SINGULANCE — the sovereign AI memory workspace (HIVEMIND desktop)",
  "main": "src/main.js",
  "author": "amarsai3012005",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "ELECTRON_IS_DEV=1 electron .",
    "build:react": "cd ../frontend/Da-vinci && REACT_APP_CONTROL_PLANE_URL=${REACT_APP_CONTROL_PLANE_URL:-https://api.singulancelabs.com} REACT_APP_CORE_API_URL=${REACT_APP_CORE_API_URL:-https://core.singulancelabs.com} REACT_APP_HIVEMIND_SITE_HOST=${REACT_APP_HIVEMIND_SITE_HOST:-electron} CI=false npm run build",
    "copy:react": "rm -rf react-build && cp -r ../frontend/Da-vinci/build react-build",
    "build": "electron-builder build --mac",
    "build:arm64": "electron-builder build --mac --arm64",
    "build:x64": "electron-builder build --mac --x64",
    "build:universal": "electron-builder build --mac --universal",
    "build:win": "electron-builder build --win",
    "dist": "electron-builder build --mac --publish=never",
    "dist:win": "electron-builder build --win --publish=never"
  },
  "build": {
    "appId": "com.singulancelabs.desktop",
    "productName": "SINGULANCE",
    "copyright": "Copyright © 2026 SINGULANCE",
    "afterSign": "scripts/notarize.js",
    "protocols": [
      {
        "name": "SINGULANCE",
        "schemes": [
          "singulance"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SINGULANCE"
    },
    "dmg": {
      "title": "SINGULANCE",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "amar3012005",
      "repo": "HIVEMIND"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.4",
    "electron-log": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "@electron/notarize": "^2.5.0"
  }
}
