{
  # Bootstrap is loopback-only: Compose binds hm-edge to 127.0.0.1. The local
  # setup wizard replaces this with Caddyfile after OIDC verification.
  auto_https disable_redirects
}

:8787 {
  tls internal

  handle /setup {
    reverse_proxy hm-control-plane:3001
  }
  handle /v1/setup/* {
    reverse_proxy hm-control-plane:3001
  }
  reverse_proxy hm-core:3000
}
