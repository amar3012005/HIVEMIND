{
  "manifest_version": 3,
  "name": "HIVEMIND \u2014 Persistent Memory for AI",
  "version": "1.2.0",
  "description": "Talk to HIVE \u2014 AI chat with perfect memory and browser context.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "tabs",
    "sidePanel",
    "identity",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://core.hivemind.davinciai.eu:8050/*",
    "https://api.hivemind.davinciai.eu:8040/*",
    "https://hivemind.davinciai.eu/*",
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "autofill.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HIVEMIND",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "commands": {
    "toggle-chat": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Toggle Talk to HIVE side panel"
    }
  }
}