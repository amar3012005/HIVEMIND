{
  "manifest_version": 3,
  "name": "HIVEMIND \u2014 Memory & Meeting Intelligence",
  "version": "2.3.0",
  "description": "Company memory, private meeting assistance, and durable meeting notes for Google Meet, Teams, Zoom, Webex and Jitsi.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "tabs",
    "sidePanel",
    "identity",
    "clipboardWrite",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://core.singulancelabs.com/*",
    "https://api.singulancelabs.com/*",
    "https://next.singulancelabs.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "autofill.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "optional_host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HIVEMIND",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "commands": {
    "toggle-chat": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Toggle Talk to HIVE side panel"
    }
  },
  "minimum_chrome_version": "116",
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.zoom.us/*",
        "https://zoom.us/*",
        "https://*.webex.com/*",
        "https://webex.com/*",
        "https://meet.jit.si/*"
      ],
      "js": [
        "meeting-common.js",
        "meeting-detect.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
