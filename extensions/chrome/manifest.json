{
  "manifest_version": 3,
  "name": "HIVEMIND Chat — AI Memory + Browser Automation",
  "version": "2.2.1",
  "description": "AI chat with perfect memory and browser context. See everything, remember everything, do anything.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "scripting",
    "tabs",
    "debugger",
    "sidePanel"
  ],
  "host_permissions": [
    "https://core.hivemind.davinciai.eu:8050/*",
    "https://api.hivemind.davinciai.eu:8040/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HIVEMIND Chat Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "side-panel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["chat-overlay.js"],
      "css": ["chat-overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-chat": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Toggle HIVEMIND chat overlay"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["extractors.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
