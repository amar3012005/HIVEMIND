# Copy to an untracked infra/.env.next on the server. Never reuse production values.
NEXT_VERSION=hivemind-next-20260709
NEXT_POSTGRES_USER=hivemind_next
NEXT_POSTGRES_PASSWORD=replace-with-random-secret
NEXT_POSTGRES_DB=hivemind_next
NEXT_DATABASE_URL=postgresql://hivemind_next:replace-with-random-secret@postgres-next:5432/hivemind_next?schema=hivemind
NEXT_REDIS_PASSWORD=replace-with-random-secret
NEXT_QDRANT_API_KEY=replace-with-random-secret
NEXT_HIVEMIND_MASTER_API_KEY=replace-with-random-secret
NEXT_SESSION_SECRET=replace-with-random-secret
NEXT_ADMIN_SECRET=replace-with-random-secret
NEXT_ALLOWED_ORIGINS=https://b2b-next.singulancelabs.com,https://b2c-next.singulancelabs.com
# Server-side integration credentials. Register both service-specific callback
# URLs from docker-compose.next.yml with the identity provider before enabling.
NEXT_ZITADEL_ISSUER_URL=https://replace-with-zitadel-issuer
NEXT_ZITADEL_CLIENT_ID=replace-with-client-id
NEXT_ZITADEL_CLIENT_SECRET=replace-with-client-secret
NEXT_GOOGLE_CLIENT_ID=replace-with-google-client-id
NEXT_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
NEXT_CARTESIA_API_KEY=replace-with-cartesia-api-key
NEXT_CARTESIA_AGENT_ID=replace-with-cartesia-agent-id
NEXT_B2B_CORE_PORT=2126
NEXT_B2B_CONTROL_PORT=2127
NEXT_B2C_CORE_PORT=2226
NEXT_B2C_CONTROL_PORT=2227
NEXT_B2B_FRONTEND_PORT=2188
NEXT_B2C_FRONTEND_PORT=2288
NEXT_FRONTEND_PORT=2388
