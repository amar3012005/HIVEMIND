	handle /v1/byod/* {
		reverse_proxy localhost:8790
	}
	reverse_proxy localhost:2027
}
nango.singulancelabs.com {
	reverse_proxy localhost:3003
}
singulancelabs.com {
	handle /api/waitlist* {
		reverse_proxy localhost:8095
	}
	handle /hivemind* {
		redir https://next.singulancelabs.com{uri} permanent
	}
	reverse_proxy localhost:8088
}
www.singulancelabs.com {
	redir https://singulancelabs.com{uri}
}

founder.singulancelabs.com {
	root * /srv/sites/founder
	file_server
	redir / /meeting_schedule/ 302
}
# Append only after both loopback health checks pass. Restart hm-caddy afterwards.
# Production core/api routes remain untouched on ports 2026/2027.





