core.singulancelabs.com {
	handle /voice2/* {
		uri strip_prefix /voice2
		reverse_proxy localhost:8091
	}
	handle /voice-grok/* {
		uri strip_prefix /voice-grok
		reverse_proxy localhost:8092
	}
	reverse_proxy localhost:2026
}
