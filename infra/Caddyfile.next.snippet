# Append only after both loopback health checks pass. Restart hm-caddy afterwards.
# Production core/api routes remain untouched on ports 2026/2027.

next.singulancelabs.com {
	reverse_proxy localhost:2388
}

# Platform-commercial surface. It intentionally serves the same immutable
# frontend image, whose host gate renders only the passkey-protected admin UI.
admin.hivemind.singulancelabs.com {
	reverse_proxy localhost:2388
}

b2b-next.singulancelabs.com {
	reverse_proxy localhost:2188
}

b2c-next.singulancelabs.com {
	reverse_proxy localhost:2288
}

b2b-next-core.singulancelabs.com {
	reverse_proxy localhost:2126
}

b2b-next-api.singulancelabs.com {
	reverse_proxy localhost:2127
}

b2c-next-core.singulancelabs.com {
	reverse_proxy localhost:2226
}

b2c-next-api.singulancelabs.com {
	reverse_proxy localhost:2227
}
