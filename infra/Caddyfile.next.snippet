	reverse_proxy localhost:2126
}

b2b-next-api.singulancelabs.com {
	reverse_proxy localhost:2127
}

b2c-next-core.singulancelabs.com {
	reverse_proxy localhost:2226
}

b2c-next-api.singulancelabs.com {
	reverse_proxy localhost:2227
}
