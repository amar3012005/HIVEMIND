{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SINGULANCE deterministic agent task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "id",
    "skill",
    "modelTier",
    "repository",
    "baseBranch",
    "objective",
    "files",
    "allowedCommands",
    "checks",
    "risk"
  ],
  "properties": {
    "contractVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$" },
    "skill": { "enum": ["memory-platform", "identity-platform", "cordis-harness-platform", "tara-voice-platform", "platform-security-audit", "platform-evals", "platform-release"] },
    "modelTier": { "enum": ["luna", "terra", "sol-astra"] },
    "repository": { "type": "string", "minLength": 1 },
    "baseBranch": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 12 },
    "files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "allowedCommands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "risk": { "enum": ["mechanical", "bounded", "critical"] },
    "requiresApproval": { "type": "boolean" },
    "release": { "type": "string", "enum": ["none", "local", "enigma", "production"] },
    "rollback": { "type": "string", "minLength": 1 },
    "dependencies": { "type": "array", "items": { "type": "string" } }
  }
}
