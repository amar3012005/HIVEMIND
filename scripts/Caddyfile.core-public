{
    admin off
}

https://core.hivemind.davinciai.eu:443 {
    handle /poool/* {
        uri strip_prefix /poool
        reverse_proxy poool-mcp:8000
    }

    handle /aaas/* {
        uri strip_prefix /aaas
        reverse_proxy tara-aaas:8090
    }

    handle {
        reverse_proxy hm-core:3000 {
            lb_try_duration 5s
            lb_try_interval 250ms
            health_uri /health
            health_interval 3s
            health_timeout 2s
            health_status 2xx
            fail_duration 15s
            max_fails 1
        }
    }

    tls /etc/letsencrypt/live/core.hivemind.davinciai.eu/fullchain.pem /etc/letsencrypt/live/core.hivemind.davinciai.eu/privkey.pem
}

poool.blaiq.ai {
    reverse_proxy poool-mcp:8000
}
