#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PROJECT=hivemind-chat-local
LOCK="$ROOT/infra/harness-chat-release.lock.json"
ENV_FILE="${HIVEMIND_CHAT_ENV_FILE:-$ROOT/infra/.env.hivemind-chat.local}"
EXAMPLE="$ROOT/infra/.env.hivemind-chat.example"
HARNESS_SOURCE="${HIVEMIND_HARNESS_SOURCE:-/Users/amar/deepseek-harness-upstream-clean-preview}"
if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
  HARNESS_SOURCE="${HIVEMIND_HARNESS_SOURCE:-$HARNESS_SOURCE}"
fi
# Preview email credentials are kept out of the repository and plaintext env
# files. Prefer an explicit process/env-file value, then the local Keychain.
if [[ -z "${HIVEMIND_PREVIEW_EMAIL_GATEWAY_TOKEN:-}" ]] && command -v security >/dev/null 2>&1; then
  HIVEMIND_PREVIEW_EMAIL_GATEWAY_TOKEN="$(security find-generic-password -a "${USER}" -s singulance-preview-mailer-token -w 2>/dev/null || true)"
  export HIVEMIND_PREVIEW_EMAIL_GATEWAY_TOKEN
fi
if [[ -z "${HIVEMIND_MASTER_API_KEY:-}" || "${HIVEMIND_MASTER_API_KEY:-}" == "hm_master_key_99228811" ]] && command -v security >/dev/null 2>&1; then
  HIVEMIND_MASTER_API_KEY="$(security find-generic-password -a "${USER}" -s hivemind-chat-local-master-api-key -w 2>/dev/null || true)"
  export HIVEMIND_MASTER_API_KEY
fi
if [[ -z "${HIVE_HARNESS_EDGE_EVAL_SECRET:-}" ]] && command -v security >/dev/null 2>&1; then
  HIVE_HARNESS_EDGE_EVAL_SECRET="$(security find-generic-password -a "${USER}" -s hivemind-harness-edge-eval-secret -w 2>/dev/null || true)"
  export HIVE_HARNESS_EDGE_EVAL_SECRET
fi
if [[ -z "${CLOUDFLARE_API_KEY:-}" ]] && command -v security >/dev/null 2>&1; then
  CLOUDFLARE_API_KEY="$(security find-generic-password -a "${USER}" -s hivemind-cloudflare-api-key -w 2>/dev/null || true)"
  if [[ -z "$CLOUDFLARE_API_KEY" ]]; then
    CLOUDFLARE_API_KEY="$(security find-generic-password -s deepseek-harness-cloudflare-ai-gateway -w 2>/dev/null || true)"
  fi
  export CLOUDFLARE_API_KEY
fi
if [[ -z "${COMPOSIO_API_KEY:-}" ]] && command -v security >/dev/null 2>&1; then
  COMPOSIO_API_KEY="$(security find-generic-password -a "${USER}" -s hivemind-composio-api-key -w 2>/dev/null || true)"
  export COMPOSIO_API_KEY
fi
FILES=(-f "$ROOT/infra/docker-compose.hivemind-chat.yml")
FOREIGN_CONTAINERS=(
  hm-core hm-control hm-postgres hm-redis hm-nango hm-playwright hm-employees
  hivemind-api hivemind-control-plane-local hivemind-employees-local
  hivemind-preview-core-compat hivemind-local-preview-tunnel
  hivemind-hyperagents-e2e-20260910
)

say() { printf '%-5s %s\n' "$1" "$2"; }
sha() { git -C "$1" rev-parse HEAD 2>/dev/null || printf missing; }
branch() { git -C "$1" branch --show-current 2>/dev/null || printf unknown; }
lock() { node -e "const x=require(process.argv[1]);process.stdout.write(String(x[process.argv[2]]||''))" "$LOCK" "$1"; }
compose() {
  local env=()
  [[ -f "$ENV_FILE" ]] && env=(--env-file "$ENV_FILE")
  HIVEMIND_CHAT_ENV_FILE="$ENV_FILE" docker compose -p "$PROJECT" "${env[@]}" "${FILES[@]}" "$@"
}
configured() { [[ -n "${!1:-}" ]] || { [[ -f "$ENV_FILE" ]] && grep -Eq "^${1}=.+" "$ENV_FILE" && ! grep -Eq "^${1}=replace-with-" "$ENV_FILE"; }; }
env_val() {
  if [[ -n "${!1:-}" ]]; then printf '%s' "${!1}"; return; fi
  [[ -f "$ENV_FILE" ]] || return 0
  awk -F= -v k="$1" '$1==k {sub(/^[^=]*=/, ""); print; exit}' "$ENV_FILE"
}

ensure_volumes() {
  docker volume create hivemind-postgres-data >/dev/null
  docker volume create hivemind-qdrant-data >/dev/null
  docker volume create hivemind-docling-models >/dev/null
  docker volume create hivemind-redis-data >/dev/null
}

OWNED_CONTAINERS=(
  hivemind-postgres hivemind-postgres-bootstrap hivemind-redis hivemind-qdrant hivemind-docling
  hivemind-core hivemind-control-plane hivemind-employees hivemind-nango
  hivemind-playwright hivemind-harness-runner hivemind-origin-gateway
  hivemind-cloudflared
)

REQUIRED_HEALTHY_CONTAINERS=(
  hivemind-postgres hivemind-redis hivemind-qdrant hivemind-docling
  hivemind-core hivemind-control-plane hivemind-employees hivemind-nango
  hivemind-playwright hivemind-harness-runner hivemind-origin-gateway
)

container_exists() {
  docker ps -a --format '{{.Names}}' | grep -Fxq "$1"
}

stop_foreign() {
  local name project
  for name in "${FOREIGN_CONTAINERS[@]}"; do
    if container_exists "$name"; then
      say INFO "stopping foreign container $name"
      docker rm -f "$name" >/dev/null
    fi
  done
  for name in "${OWNED_CONTAINERS[@]}"; do
    container_exists "$name" || continue
    project="$(docker inspect --type container -f '{{index .Config.Labels "com.docker.compose.project"}}' "$name" 2>/dev/null || true)"
    if [[ -n "$project" && "$project" != "$PROJECT" ]]; then
      say INFO "reclaiming $name from project $project"
      docker rm -f "$name" >/dev/null
    fi
  done
}

status() {
  say INFO "HIVEMIND $(branch "$ROOT") $(sha "$ROOT")"
  say INFO "Da-vinci $(git -C "$ROOT" ls-tree HEAD frontend/Da-vinci | awk '{print $3}')"
  say INFO "Harness $(branch "$HARNESS_SOURCE") $(sha "$HARNESS_SOURCE")"
  say INFO "profile=hivemind-chat project=$PROJECT file=infra/docker-compose.hivemind-chat.yml env=$([[ -f "$ENV_FILE" ]] && echo present || echo missing)"
  say INFO "authority identity=control-plane session=postgres memory=core coordination=redis"
  docker ps --format '{{.Names}} {{.Image}} {{.Status}} {{.Networks}}' 2>/dev/null | grep -E '^(hivemind-|hm-|.*harness|.*caddy|.*cloudflared)' || true
}

doctor() {
  local allow_dev_mounts="${1:-0}"
  local bad=0 actual expected mounts creds projects
  fail() { say RED "$1"; bad=1; }
  [[ "$(branch "$ROOT")" != singulance-main ]] || fail "refusing production branch"
  expected="$(lock hivemindBaselineCommit)"
  git -C "$ROOT" merge-base --is-ancestor "$expected" HEAD || fail "HIVEMIND is not based on locked singulance-local baseline"
  expected="$(lock harnessCommit)"
  actual="$(sha "$HARNESS_SOURCE")"
  [[ "$actual" == "$expected" ]] || fail "Harness SHA drift or floating tag"
  [[ "$expected" =~ ^[0-9a-f]{40}$ ]] || fail "locked Harness SHA is not a full commit"
  expected="$(lock davinciCommit)"
  actual="$(git -C "$ROOT" ls-tree HEAD frontend/Da-vinci | awk '{print $3}')"
  [[ "$actual" == "$expected" ]] || fail "Da-vinci SHA drift"
  [[ -f "$ENV_FILE" ]] || fail "missing $ENV_FILE"
  for key in HIVEMIND_HARNESS_SOURCE HIVEMIND_HARNESS_COMMIT_HASH HIVE_HARNESS_TICKET_SECRET HIVE_HARNESS_RUNNER_SERVICE_SECRET HIVE_HARNESS_EDGE_EVAL_SECRET CLOUDFLARED_CREDENTIALS_FILE NANGO_SECRET_KEY PLAYWRIGHT_SERVICE_TOKEN HIVEMIND_PREVIEW_EMAIL_GATEWAY_TOKEN HIVEMIND_MASTER_API_KEY CLOUDFLARE_API_KEY; do
    configured "$key" || fail "$key missing"
  done
  [[ "$(env_val HIVEMIND_MASTER_API_KEY)" != "hm_master_key_99228811" ]] || fail "placeholder HIVEMIND_MASTER_API_KEY is forbidden"
  [[ "$(env_val HIVEMIND_HARNESS_COMMIT_HASH)" == "$(lock harnessCommit)" ]] || fail "env Harness SHA does not match lock"
  creds="$(env_val CLOUDFLARED_CREDENTIALS_FILE)"
  [[ -n "$creds" && -f "$creds" ]] || fail "cloudflared credentials file missing"
  [[ "${COMPOSE_FILE:-}" != *harness-hotfix* ]] || fail "hotfix overlay active"
  [[ "${COMPOSE_FILE:-}" != *local-stack* && "${COMPOSE_FILE:-}" != *local-services* ]] || fail "transitional compose overlay active"
  grep -Eq 'packages/client.+:/opt/deepseek-harness' "$ROOT/infra/docker-compose.hivemind-chat.yml" && fail "package bind mount in canonical overlay"
  compose config --quiet >/dev/null || fail "Compose model invalid"
  local name
  for name in "${FOREIGN_CONTAINERS[@]}"; do
    docker ps --format '{{.Names}}' | grep -Fxq "$name" && fail "foreign container still running: $name"
  done
  projects="$(docker compose ls -q 2>/dev/null | grep -E 'hm-hyper-contract|hivemind-dev|hivemind-next' || true)"
  [[ -z "$projects" ]] || fail "duplicate Compose projects: $projects"
  mounts="$(docker inspect hivemind-harness-runner --format '{{range .Mounts}}{{.Destination}} {{end}}' 2>/dev/null || true)"
  if [[ "$allow_dev_mounts" != 1 ]]; then
    [[ "$mounts" != *'/opt/deepseek-harness/packages/'* ]] || fail "runner has package bind mounts"
  fi
  [[ "$bad" -eq 0 ]] || return 1
  say OK "doctor passed"
}

release_runner() {
  # A development refresh may use validated read-only mounts for speed, but a
  # release always returns to one immutable image and the canonical Compose
  # model. Docker's cache keeps unchanged layers; only harness-runner is built
  # and recreated, so every other service retains its environment and state.
  doctor 1
  compose build harness-runner
  compose up -d --no-deps --force-recreate harness-runner
  local deadline=$((SECONDS + 180)) state
  until [[ "$(docker inspect --type container -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' hivemind-harness-runner 2>/dev/null || printf missing)" == healthy ]]; do
    (( SECONDS < deadline )) || { say RED "Harness runner did not become healthy"; return 1; }
    sleep 3
  done
  doctor
  curl -fsS -H 'Host: next.preview.singulancelabs.com' http://127.0.0.1:18080/health >/dev/null
  say OK "locked Harness image is healthy without package bind mounts"
}

verify_health() {
  local name status bad=0
  for name in "${REQUIRED_HEALTHY_CONTAINERS[@]}"; do
    status="$(docker inspect --type container -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$name" 2>/dev/null || printf missing)"
    if [[ "$status" != healthy ]]; then
      say RED "$name is $status"
      bad=1
    fi
  done
  [[ "$bad" -eq 0 ]] || return 1
  say OK "all required services healthy"
}

wait_healthy() {
  local deadline=$((SECONDS + 300))
  until verify_health >/dev/null 2>&1; do
    (( SECONDS < deadline )) || { verify_health; return 1; }
    sleep 3
  done
  verify_health
}

refresh_core_auth() {
  # The Control Plane and Core must always receive the same non-placeholder
  # internal key. Run this through this wrapper so Keychain hydration happens
  # before Compose evaluates its ${...:?required} substitutions.
  doctor
  compose up -d --no-build --no-deps --force-recreate core control-plane
  local deadline=$((SECONDS + 180)) state
  until [[ "$(docker inspect --type container -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' hivemind-core 2>/dev/null || printf missing)" == healthy \
      && "$(docker inspect --type container -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' hivemind-control-plane 2>/dev/null || printf missing)" == healthy ]]; do
    (( SECONDS < deadline )) || { say RED "Core or Control Plane did not become healthy"; return 1; }
    sleep 3
  done
  docker exec hivemind-control-plane node -e 'import("./src/security/internal-auth.js").then(({getInternalApiKey}) => { const value = getInternalApiKey({ allowDevFallback: false }); if (value === "hm_master_key_99228811") process.exit(1); console.log("internal auth key accepted"); })'
  docker exec hivemind-core node -e 'import("./src/embeddings/factory.js").then(async ({getEmbedService}) => { const value = await getEmbedService().embedOne("hivemind local readiness", { workload: "interactive" }); if (!Array.isArray(value) || value.length !== 1024) process.exit(1); console.log("embedding provider accepted (1024 dimensions)"); })'
  say OK "Core and Control Plane share an accepted internal auth key"
}

refresh_control_plane() {
  # Re-evaluate Control Plane configuration through the same Keychain-hydrated
  # Compose boundary without rebuilding or disturbing any other service.
  doctor
  compose up -d --no-build --no-deps --force-recreate control-plane
  local deadline=$((SECONDS + 180))
  until [[ "$(docker inspect --type container -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' hivemind-control-plane 2>/dev/null || printf missing)" == healthy ]]; do
    (( SECONDS < deadline )) || { say RED "Control Plane did not become healthy"; return 1; }
    sleep 3
  done
  [[ "$(docker inspect hivemind-control-plane --format '{{range .Config.Env}}{{println .}}{{end}}' | sed -n 's/^HIVE_HARNESS_FLAG_URL=//p')" == "https://next.preview.singulancelabs.com/__hivemind/feature-flags/harness-chat" ]] \
    || { say RED "Control Plane does not use the canonical preview flag URL"; return 1; }
  say OK "Control Plane uses the canonical next.preview flag URL"
}

test_all() {
  doctor
  verify_health
  (cd "$HARNESS_SOURCE" && pnpm exec vitest run packages/hivemind/connected-apps/tests/connected-apps.spec.ts)
  (cd "$HARNESS_SOURCE" && pnpm dsh --profile hivemind-web --dump-config >/tmp/hivemind-chat-profile.json)
  grep -q '@deepseek-ai/dsh-hivemind-web-app' /tmp/hivemind-chat-profile.json
  say OK "connected-apps and resolved-profile checks passed"
  say INFO "run authenticated acceptance in docs/acceptance/HARNESS_CHAT_E2E.md"
}

case "${1:-status}" in
  status) status ;;
  doctor) doctor ;;
  stop-foreign) stop_foreign ;;
  up) doctor; compose up -d --no-build; wait_healthy; compose ps ;;
  up-all)
    ensure_volumes
    stop_foreign
    doctor
    compose up -d --no-build
    wait_healthy
    compose ps
    ;;
  restart) doctor; compose up -d --no-build --no-deps --force-recreate harness-runner; wait_healthy ;;
  release-runner) release_runner ;;
  refresh-control-plane) refresh_control_plane ;;
  refresh-core-auth) refresh_core_auth ;;
  health) verify_health ;;
  test) test_all ;;
  down) compose down ;;
  *) echo "usage: $0 status|doctor|health|stop-foreign|up|up-all|restart|release-runner|refresh-control-plane|refresh-core-auth|test|down"; exit 2 ;;
esac
