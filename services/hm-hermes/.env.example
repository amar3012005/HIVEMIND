# hm-hermes env template — copy to Coolify env / .env (NEVER commit real values).
# Gateway (OpenAI-compatible API used by hm-control)
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_KEY=                 # generate: openssl rand -hex 32  (REQUIRED)
# Dashboard (admin UI on :9119)
HERMES_DASHBOARD=1
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_PORT=9119
# Dashboard auth — pick ONE (do NOT use INSECURE on a public network):
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# HERMES_DASHBOARD_INSECURE=1    # only behind a trusted reverse proxy
# Permissions to match host volume owner
PUID=1000
PGID=1000
# HiveMind MCP (memory system of record) — consumed in Phase 3 via mcp.json
HIVEMIND_API_URL=https://core.hivemind.davinciai.eu:8050
HIVEMIND_API_KEY=               # per-tenant key, injected by hm-control
# Shim → gateway (Phase 4)
HERMES_GATEWAY_URL=http://127.0.0.1:8642
