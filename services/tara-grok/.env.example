# Required production secrets. Store at /opt/tara-grok/.env with mode 0600.
XAI_API_KEY=
TARA_GROK_SERVICE_TOKEN=
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime
TARA_GROK_MODEL=grok-voice-think-fast-1.0
HIVEMIND_CORE_EVENTS_URL=http://core:3000/internal/v1/tara/calls
# Enable only after account entitlement and region validation.
TARA_GROK_CUSTOM_VOICES_ENABLED=0
