{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hivemind-day1-lifecycle",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "HIVEMIND_CONTROL_URL": "https://api.singulancelabs.com"
  },
  "flagship": [
    {
      "binding": "FLAGS",
      "app_id": "2e89fbd3-7496-459b-a507-f1017d444dd9"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "workflows": [
    {
      "name": "hivemind-day1-lifecycle",
      "binding": "DAY1_WORKFLOW",
      "class_name": "DayOneWorkflow"
    }
  ]
}
