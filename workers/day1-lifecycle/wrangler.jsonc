{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hivemind-day1-lifecycle",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "HIVEMIND_CONTROL_URL": "https://api.singulancelabs.com",
    "HIVEMIND_D1_RECONCILE_LIMIT": "5"
  },
  "flagship": [
    {
      "binding": "FLAGS",
      "app_id": "2e89fbd3-7496-459b-a507-f1017d444dd9",
      "remote": true
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "workflows": [
    {
      "name": "hivemind-day1-lifecycle",
      "binding": "DAY1_WORKFLOW",
      "class_name": "DayOneWorkflow"
    }
  ],
  "env": {
    "local": {
      "name": "hivemind-day1-lifecycle-local",
      "vars": {
        "HIVEMIND_CONTROL_URL": "https://preview-api.singulancelabs.com",
        "HIVEMIND_D1_INSTANCE_PREFIX": "d1-local7",
        "HIVEMIND_D1_RECONCILE_LIMIT": "100"
      },
      "flagship": [
        {
          "binding": "FLAGS",
          "app_id": "6568ec71-67c6-4b2c-b2f3-98aebe9e81c8",
          "remote": true
        }
      ],
      "workflows": [
        {
          "name": "hivemind-day1-lifecycle-local",
          "binding": "DAY1_WORKFLOW",
          "class_name": "DayOneWorkflow"
        }
      ]
    }
  }
}
