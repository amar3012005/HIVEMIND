{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hivemind-dreamer-dispatch",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "local",
    "DISPATCH_ENABLED": "false",
    "DSH_TRIGGER_URL": ""
  },
  "durable_objects": {
    "bindings": [{ "name": "TENANT_SCHEDULES", "class_name": "TenantSchedules" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TenantSchedules"] }],
  "queues": {
    "producers": [{ "binding": "DREAMER_QUEUE", "queue": "hivemind-dreamer-dispatch-local" }],
    "consumers": [{
      "queue": "hivemind-dreamer-dispatch-local",
      "max_batch_size": 10,
      "max_batch_timeout": 5,
      "max_retries": 8,
      "dead_letter_queue": "hivemind-dreamer-dispatch-dlq-local",
      "max_concurrency": 5,
      "retry_delay": 30
    }]
  },
  "env": {
    "preview": {
      "name": "hivemind-dreamer-dispatch-preview",
      "vars": {
        "ENVIRONMENT": "preview",
        "DISPATCH_ENABLED": "false",
        "DSH_TRIGGER_URL": ""
      },
      "durable_objects": {
        "bindings": [{ "name": "TENANT_SCHEDULES", "class_name": "TenantSchedules" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TenantSchedules"] }],
      "queues": {
        "producers": [{ "binding": "DREAMER_QUEUE", "queue": "hivemind-dreamer-dispatch-preview" }],
        "consumers": [{
          "queue": "hivemind-dreamer-dispatch-preview",
          "max_batch_size": 10,
          "max_batch_timeout": 5,
          "max_retries": 8,
          "dead_letter_queue": "hivemind-dreamer-dispatch-dlq-preview",
          "max_concurrency": 5,
          "retry_delay": 30
        }]
      }
    }
  }
}
