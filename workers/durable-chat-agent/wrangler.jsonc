{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hivemind-durable-chat-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development",
    "DURABLE_CHAT_FLAG": "durable_chat_agent_v1",
    "NATIVE_META_FLAG": "hivemind-unified-meta-loop-v2",
    "UNIFIED_DAG_FLAG": "USE_TOOLS_UNIFIED_DAG",
    "CHAT_ORCHESTRATOR_V2_FLAG": "chat_orchestrator_v2",
    "COMPOUND_ORCHESTRATOR_FLAG": "compound_orchestrator_v1",
    "MEETING_LIFECYCLE_FLAG": "meeting_lifecycle_v2"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "durable_objects": {
    "bindings": [{ "name": "CHAT_SESSION", "class_name": "HivemindChatSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HivemindChatSession"] }],
  "workflows": [{
    "name": "hivemind-chat-turn-workflow-development",
    "binding": "CHAT_TURN_WORKFLOW",
    "class_name": "ChatTurnWorkflow"
  }],
  "env": {
    "local": {
      "name": "hivemind-durable-chat-agent-local",
      "durable_objects": {
        "bindings": [{ "name": "CHAT_SESSION", "class_name": "HivemindChatSession" }]
      },
      "vars": {
        "ENVIRONMENT": "local",
        "DURABLE_CHAT_FLAG": "durable_chat_agent_v1",
        "NATIVE_META_FLAG": "hivemind-unified-meta-loop-v2",
        "UNIFIED_DAG_FLAG": "USE_TOOLS_UNIFIED_DAG",
        "CHAT_ORCHESTRATOR_V2_FLAG": "chat_orchestrator_v2",
        "COMPOUND_ORCHESTRATOR_FLAG": "compound_orchestrator_v1",
        "MEETING_LIFECYCLE_FLAG": "meeting_lifecycle_v2"
      },
      "flagship": [{ "binding": "FLAGS", "app_id": "6568ec71-67c6-4b2c-b2f3-98aebe9e81c8", "remote": true }],
      "workflows": [{
        "name": "hivemind-chat-turn-workflow-local",
        "binding": "CHAT_TURN_WORKFLOW",
        "class_name": "ChatTurnWorkflow"
      }]
    },
    "production": {
      "name": "hivemind-durable-chat-agent-production",
      "durable_objects": {
        "bindings": [{ "name": "CHAT_SESSION", "class_name": "HivemindChatSession" }]
      },
      "vars": {
        "ENVIRONMENT": "production",
        "DURABLE_CHAT_FLAG": "durable_chat_agent_v1",
        "NATIVE_META_FLAG": "hivemind-unified-meta-loop-v2",
        "UNIFIED_DAG_FLAG": "USE_TOOLS_UNIFIED_DAG",
        "CHAT_ORCHESTRATOR_V2_FLAG": "chat_orchestrator_v2",
        "COMPOUND_ORCHESTRATOR_FLAG": "compound_orchestrator_v1",
        "MEETING_LIFECYCLE_FLAG": "meeting_lifecycle_v2"
      },
      "flagship": [{ "binding": "FLAGS", "app_id": "6568ec71-67c6-4b2c-b2f3-98aebe9e81c8", "remote": true }],
      "workflows": [{
        "name": "hivemind-chat-turn-workflow-production",
        "binding": "CHAT_TURN_WORKFLOW",
        "class_name": "ChatTurnWorkflow"
      }]
    },
    "enigma": {
      "name": "hivemind-durable-chat-agent-enigma",
      "durable_objects": {
        "bindings": [{ "name": "CHAT_SESSION", "class_name": "HivemindChatSession" }]
      },
      "vars": {
        "ENVIRONMENT": "enigma",
        "DURABLE_CHAT_FLAG": "durable_chat_agent_v1",
        "NATIVE_META_FLAG": "hivemind-unified-meta-loop-v2",
        "UNIFIED_DAG_FLAG": "USE_TOOLS_UNIFIED_DAG",
        "CHAT_ORCHESTRATOR_V2_FLAG": "chat_orchestrator_v2",
        "COMPOUND_ORCHESTRATOR_FLAG": "compound_orchestrator_v1",
        "MEETING_LIFECYCLE_FLAG": "meeting_lifecycle_v2"
      },
      "flagship": [{ "binding": "FLAGS", "app_id": "6568ec71-67c6-4b2c-b2f3-98aebe9e81c8", "remote": true }],
      "workflows": [{
        "name": "hivemind-chat-turn-workflow-enigma",
        "binding": "CHAT_TURN_WORKFLOW",
        "class_name": "ChatTurnWorkflow"
      }]
    }
  }
}
