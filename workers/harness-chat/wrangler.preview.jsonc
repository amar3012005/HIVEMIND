{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hivemind-harness-chat-preview",
  "workers_dev": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "routes": [],
  "vars": {
    "ENVIRONMENT": "local",
    "RUNNER_ORIGIN": "https://harness-preview.singulancelabs.com",
    "HIVE_HARNESS_PARENT_ORIGINS": "https://next.preview.singulancelabs.com"
  },
  "flagship": [{
    "binding": "FLAGS",
    "app_id": "6568ec71-67c6-4b2c-b2f3-98aebe9e81c8",
    "remote": true
  }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/index.html", "/hivemind/app/overview", "/hivemind/app/overview/*", "/auth/callback", "/plugins/*", "/__hivemind/*", "/api/*", "/health"]
  }
}
