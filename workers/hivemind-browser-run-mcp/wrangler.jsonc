{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hivemind-browser-run-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "browser": { "binding": "BROWSER" },
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "HivemindBrowserMcp" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HivemindBrowserMcp"] }
  ]
}
