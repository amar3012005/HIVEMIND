{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hivemind-hyperagents-grok-local-root",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "ENVIRONMENT": "local",
    "HIVEMIND_CORE_URL": "http://127.0.0.1:3000",
    "HYPER_GROK_FLAG": "hyperagents_grok_agents_v1"
  },
  "flagship": [{ "binding": "FLAGS", "app_id": "6568ec71-67c6-4b2c-b2f3-98aebe9e81c8", "remote": true }],
  "browser": { "binding": "BROWSER", "remote": true },
  "containers": [{ "class_name": "Sandbox", "image": "./Dockerfile", "max_instances": 5 }],
  "durable_objects": {
    "bindings": [
      { "name": "HIRED_HYPER_AGENT", "class_name": "HiredHyperAgent" },
      { "name": "HYPER_ROOM_GATEWAY", "class_name": "HyperRoomGateway" },
      { "name": "Sandbox", "class_name": "Sandbox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HiredHyperAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["Sandbox"] },
    { "tag": "v3", "new_sqlite_classes": ["HyperRoomGateway"] }
  ],
  "workflows": [
    { "name": "hivemind-hyper-room-run-local", "binding": "ROOM_RUN_WORKFLOW", "class_name": "HyperRoomRunWorkflow" },
    { "name": "hivemind-hyper-agent-assignment-local", "binding": "AGENT_ASSIGNMENT_WORKFLOW", "class_name": "HyperAgentAssignmentWorkflow" }
  ],
  "env": {
    "local": {
      "name": "hivemind-hyperagents-grok-local",
      "vars": {
        "ENVIRONMENT": "local",
        "HIVEMIND_CORE_URL": "https://preview-api.singulancelabs.com",
        "HYPER_GROK_FLAG": "hyperagents_grok_agents_v1"
      },
      "flagship": [{ "binding": "FLAGS", "app_id": "6568ec71-67c6-4b2c-b2f3-98aebe9e81c8", "remote": true }],
      "browser": { "binding": "BROWSER", "remote": true },
      "containers": [{ "class_name": "Sandbox", "image": "./Dockerfile", "max_instances": 5 }],
      "durable_objects": { "bindings": [
        { "name": "HIRED_HYPER_AGENT", "class_name": "HiredHyperAgent" },
        { "name": "HYPER_ROOM_GATEWAY", "class_name": "HyperRoomGateway" },
        { "name": "Sandbox", "class_name": "Sandbox" }
      ] },
      "workflows": [
        { "name": "hivemind-hyper-room-run-local", "binding": "ROOM_RUN_WORKFLOW", "class_name": "HyperRoomRunWorkflow" },
        { "name": "hivemind-hyper-agent-assignment-local", "binding": "AGENT_ASSIGNMENT_WORKFLOW", "class_name": "HyperAgentAssignmentWorkflow" }
      ]
    },
    "production": {
      "name": "hivemind-hyperagents-grok-production",
      "vars": {
        "ENVIRONMENT": "production",
        "HIVEMIND_CORE_URL": "https://api.singulancelabs.com",
        "HYPER_GROK_FLAG": "hyperagents_grok_agents_v1"
      },
      "flagship": [{ "binding": "FLAGS", "app_id": "6568ec71-67c6-4b2c-b2f3-98aebe9e81c8", "remote": true }],
      "browser": { "binding": "BROWSER", "remote": true },
      "containers": [{ "class_name": "Sandbox", "image": "./Dockerfile", "max_instances": 20 }],
      "durable_objects": { "bindings": [
        { "name": "HIRED_HYPER_AGENT", "class_name": "HiredHyperAgent" },
        { "name": "HYPER_ROOM_GATEWAY", "class_name": "HyperRoomGateway" },
        { "name": "Sandbox", "class_name": "Sandbox" }
      ] },
      "workflows": [
        { "name": "hivemind-hyper-room-run-production", "binding": "ROOM_RUN_WORKFLOW", "class_name": "HyperRoomRunWorkflow" },
        { "name": "hivemind-hyper-agent-assignment-production", "binding": "AGENT_ASSIGNMENT_WORKFLOW", "class_name": "HyperAgentAssignmentWorkflow" }
      ]
    }
  }
}
