{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hivemind-ravi-agent-lab",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "RAVI_RESEARCH_AGENT", "class_name": "RaviResearchAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RaviResearchAgent"] }
  ]
}
