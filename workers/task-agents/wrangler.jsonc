{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hivemind-task-agents",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "ai": { "binding": "AI" },
  "browser": { "binding": "BROWSER" },
  "worker_loaders": [{ "binding": "LOADER" }],
  "vars": {
    "HIVEMIND_CONTROL_URL": "https://api.singulancelabs.com",
    "HIVEMIND_CORE_URL": "https://core.singulancelabs.com",
    "AI_GATEWAY_ID": "hivemind-prod",
    "CLOUDFLARE_ACCOUNT_ID": "0dc6b9186b5a9b8985613b10c1c59f4f",
    "AI_GATEWAY_MODEL": "@cf/zai-org/glm-5.3-flash"
  },
  "durable_objects": {
    "bindings": [{ "name": "HivemindTaskAgent", "class_name": "HivemindTaskAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HivemindTaskAgent"] }],
  "workflows": [
    {
      "name": "hivemind-task-lifecycle",
      "binding": "TASK_LIFECYCLE",
      "class_name": "TaskLifecycleWorkflow"
    }
  ],
  "env": {
    "preview": {
      "ai": { "binding": "AI" },
      "browser": { "binding": "BROWSER" },
      "secrets_store_secrets": [{
        "binding": "OPENROUTER_SPAN01_KEY",
        "store_id": "bf31d04d7a4d464d81990eff9ded7def",
        "secret_name": "hivemind-prod_openrouter_first-bundb"
      }],
      "worker_loaders": [{ "binding": "LOADER" }],
      "vars": {
        "HIVEMIND_CONTROL_URL": "https://preview-api.singulancelabs.com",
        "HIVEMIND_CORE_URL": "https://preview.singulancelabs.com",
        "AI_GATEWAY_ID": "hivemind-prod",
        "CLOUDFLARE_ACCOUNT_ID": "0dc6b9186b5a9b8985613b10c1c59f4f",
        "AI_GATEWAY_MODEL": "@cf/zai-org/glm-5.3-flash",
        "JEV_ROUTING_ENABLED": "true",
        "OPENROUTER_MODEL": "deepseek/deepseek-v4-flash-0731:nitro",
        "CLOUDFLARE_AI_GATEWAY_OPENROUTER_BYOK_ALIAS": "first-bundb",
        "SPAN01_ENABLED": "true"
      },
      "durable_objects": {
        "bindings": [{ "name": "HivemindTaskAgent", "class_name": "HivemindTaskAgent" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HivemindTaskAgent"] }],
      "workflows": [
        {
          "name": "hivemind-task-lifecycle-preview",
          "binding": "TASK_LIFECYCLE",
          "class_name": "TaskLifecycleWorkflow"
        }
      ]
    }
  }
}
